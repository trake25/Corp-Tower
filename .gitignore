# The agent contract ships with the repo — CLAUDE.md, the role skills and the
# /update-docs and /compact-docs commands are useless to a fresh clone if they
# stay local-only. Machine-local permissions are the one part that does not
# travel. plan/ and reference/ hold working material, not contract.
.claude/settings.local.json
/.agent-state/
plan/
reference/
task/
repair/
report/benchmarks/raw/
*.x86_64

# Private art asset pipeline — R2 credentials for local dev.
# The assets themselves are ignored in src/Client/App/corp-tower/.gitignore
.env.art
design-imports/
scripts/figma-ui-exporter/
scripts/figma-ui-exporter/dist/
scripts/figma-ui-exporter/figma-plugin.local.json
scripts/figma-ui-exporter/node_modules/

# Physical backup machine credentials — see scripts/backup/.env.backup.example.
# The filled-in copy belongs outside the repo checkout; ignored here only as
# a safety net if one ever ends up inside it.
.env.backup
scripts/backup/.env.backup
scripts/aws
scripts/awscliv2.zip

# CI-downloaded web build artifact staged as the docker/web Docker build context
docker/web/web/

# Portfolio site (Astro) — build artifacts only, source is tracked
site/node_modules/
site/dist/
site/.astro/
site/.wrangler/
site/public/og.png
# Local values for the contact Worker's secrets, read by `wrangler dev`.
# The deployed ones live in Cloudflare, never here.
site/.dev.vars

# Google sign-in Android plugin (Kotlin/Gradle) — build.md documents rebuilding
# it with scripts/build-android-plugin.sh; only its source is tracked.
plugins/godot-google-signin/.gradle/
plugins/godot-google-signin/build/
plugins/godot-google-signin/plugin/build/
plugins/godot-google-signin/local.properties
