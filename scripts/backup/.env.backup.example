# Corp Tower — physical backup machine, machine-local state
#
# Copy this file to $CORP_TOWER_BACKUP_STATE_DIR/.env.backup (default
# ~/corp-tower-server-backup/.env.backup) and fill it in:
#   mkdir -p ~/corp-tower-server-backup
#   cp scripts/backup/.env.backup.example ~/corp-tower-server-backup/.env.backup
#   chmod 600 ~/corp-tower-server-backup/.env.backup
#
# This file itself holds no secrets and is committed. The filled-in copy
# lives outside the repo checkout — actions/checkout's clean step wipes
# gitignored/untracked files inside the checkout on every CI run, so nothing
# that needs to persist across runs (this file, web-content-*/) can live
# there.

# --- Game server instances (devwstod1 / devwstod2 / wstoddemo) ---
# Deliberately separate hostnames from the K3s-hosted wsplaytod/wstodtest.
WS1_DOMAIN=devwstod1.galaxxigames.com
WS1_PORT=3001
WS2_DOMAIN=devwstod2.galaxxigames.com
WS2_PORT=3002
# Public portfolio demo — always-on, bots enabled. See
# plan/corp-tower-demo-instance-plan.md.
WS3_DOMAIN=wstoddemo.galaxxigames.com
WS3_PORT=3003

# --- Web (HTML5) server instances (devtod1 / devtod2 / toddemo) ---
# Deliberately separate hostnames from the K3s-hosted playtod/todtest.
WEB1_DOMAIN=devtod1.galaxxigames.com
WEB1_PORT=8091
WEB2_DOMAIN=devtod2.galaxxigames.com
WEB2_PORT=8092
WEB3_DOMAIN=toddemo.galaxxigames.com
WEB3_PORT=8093

# Git commits/builds currently expected to be live per instance.
# backup-server-up.sh compares CORP_TOWER_WS<n>_IMAGE_TAG against
# `git rev-parse HEAD` and asks for confirmation on mismatch, so a manual
# run never silently ships different code than what was last deployed.
# backup-web-up.sh sets CORP_TOWER_WEB<n>_BUILD_SHA after every deploy;
# backup-web-status.sh diffs it against origin/main.
CORP_TOWER_WS1_IMAGE_TAG=
CORP_TOWER_WS2_IMAGE_TAG=
CORP_TOWER_WS3_IMAGE_TAG=
CORP_TOWER_WEB1_BUILD_SHA=
CORP_TOWER_WEB2_BUILD_SHA=
CORP_TOWER_WEB3_BUILD_SHA=

# Cloudflare API token scoped to Zone.DNS Edit on galaxxigames.com only.
# Use a SEPARATE token from CI's CLOUDFLARE_API_TOKEN secret — a compromise
# of this machine then can't touch the AWS-side K3s DNS records.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Tunnel ID from `cloudflared tunnel create corp-tower-backup` — the <id> in
# <id>.cfargotunnel.com. Find it again anytime with `cloudflared tunnel list`.
# All six instances share one tunnel with six ingress rules — see
# ~/.cloudflared/config.yml on this machine (not in the repo).
CLOUDFLARE_TUNNEL_ID=
