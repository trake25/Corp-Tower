{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corp-tower-portfolio",
  "compatibility_date": "2026-07-03",
  // The site is still a static build. `main` adds exactly one server route --
  // the contact form's -- and `run_worker_first` scopes the Worker to it, so
  // every other request goes straight to the asset router and
  // `not_found_handling` keeps serving the built 404 page.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/contact"]
  },
  // How many messages a day the form may send before it starts refusing. Sized
  // under the mail provider's free daily allowance, not at it. Inert until a
  // CONTACT_KV binding exists to count against it.
  "vars": {
    "CONTACT_DAILY_CAP": "50"
  },
  // Cloudflare's own rate limiter: account-local, no external service, no
  // dependency. `period` accepts only 10 or 60 seconds, which is why the daily
  // ceiling above is counted in KV instead.
  "ratelimits": [
    {
      "name": "CONTACT_RL_IP",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "CONTACT_RL_ALL",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
  // No kv_namespaces block on purpose. A binding naming a namespace id that
  // does not exist fails `wrangler deploy` outright -- and it would fail it for
  // the whole site, not just the form. The daily cap is optional by design: the
  // Worker turns the check off when CONTACT_KV is absent. To switch it on, run
  // `wrangler kv namespace create CONTACT_KV` and add the block with the real
  // id it prints. See site/docs/deploy.md.
}
