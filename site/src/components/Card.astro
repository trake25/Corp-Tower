---
// Three states, not two:
//   1. Vignette  — collapsed tile: role chip + summary title only.
//   2. Open      — short description, tools & tech, and the clickable diagram.
//   3. Flow open — click a diagram step (or the toggle) and the step-by-step
//                  explanations appear, scrolled to the step you clicked.
//
// `links` is intentionally not rendered — the "In the repo" block was removed.
// The data is kept in the card frontmatter so it can be brought back without
// re-collecting two dozen URLs.
interface CardLink {
  label: string;
  href: string;
}

interface CardDetail {
  id: string;
  title: string;
  body: string;
  evidence?: { label: string; href: string };
}

interface Props {
  role: string;
  headline: string;
  plain: string;
  tools: string[];
  details: CardDetail[];
  hasBody: boolean;
  links?: CardLink[];
}

const { role, headline, plain, tools, details, hasBody } = Astro.props;
const hasFlow = details.length > 0;
const roleSlug = role.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const flowId = `flow-${roleSlug}`;
const cardId = `card-${roleSlug}`;
---

<details class="card" id={cardId} data-role={role}>
  <summary>
    <span class="vignette">
      <span class="role-tag">{role}</span>
      <h3 class="headline">{headline}</h3>
      <span class="toggle-hint">
        <span class="toggle-open">Open</span>
        <span class="toggle-close">Close</span>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </span>
  </summary>

  <div class="expanded">
    <p class="plain">{plain}</p>

    {tools.length > 0 && (
      <p class="card-tools">
        <span class="card-tools-label">Tools &amp; tech</span>
        {tools.map((tool) => <span class="tool">{tool}</span>)}
      </p>
    )}

    <slot name="diagram" />

    {hasFlow ? (
      <>
        <button class="flow-toggle" type="button" aria-expanded="false" aria-controls={flowId}>
          <span class="flow-toggle-show">Show all {details.length} steps</span>
          <span class="flow-toggle-hide">Hide the steps</span>
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
            <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="flow-details" id={flowId} hidden>
          <div class="detail-list">
            {details.map((detail) => (
              <section class="detail" data-detail-target={detail.id}>
                <h4>
                  <button class="detail-jump" type="button">
                    {detail.title}
                    <span class="detail-jump-hint" aria-hidden="true">↑ diagram</span>
                  </button>
                </h4>
                <p>{detail.body}</p>
                {detail.evidence && (
                  <a
                    class="detail-evidence"
                    href={detail.evidence.href}
                    target={detail.evidence.href.includes("#card-") ? undefined : "_blank"}
                    rel={detail.evidence.href.includes("#card-") ? undefined : "noopener noreferrer"}
                  >
                    {detail.evidence.label}
                    {detail.evidence.href.includes("#card-") ? (
                      <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
                        <path d="M2.5 6 H9.5 M6 2.5 L9.5 6 L6 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
                        <path d="M3.5 8.5 L8.5 3.5 M8.5 3.5 H4.9 M8.5 3.5 V7.1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </a>
                )}
              </section>
            ))}
          </div>
          {hasBody && (
            <div class="flow-body">
              <slot />
            </div>
          )}
        </div>
      </>
    ) : (
      hasBody && (
        <div class="flow-body">
          <slot />
        </div>
      )
    )}
  </div>
</details>

<script>
  // Diagram steps reveal the write-up rather than navigating anywhere: the flow
  // details start hidden, clicking any step (or the toggle) opens them, and the
  // step you clicked is highlighted and scrolled to. The toggle stays available
  // in both directions so an opened flow can be put away again.
  const motionOk = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const cards = document.querySelectorAll<HTMLDetailsElement>(".card");

  // Both halves highlight, so both have to be cleared together — otherwise a
  // reset leaves a diagram step lit with nothing selected below it.
  const clearActive = (card: HTMLElement) => {
    for (const marked of card.querySelectorAll<HTMLElement>(".is-active")) {
      marked.classList.remove("is-active");
    }
  };

  const setFlow = (card: HTMLElement, open: boolean) => {
    const flow = card.querySelector<HTMLElement>(".flow-details");
    const toggle = card.querySelector<HTMLButtonElement>(".flow-toggle");
    if (flow) flow.hidden = !open;
    toggle?.setAttribute("aria-expanded", String(open));
    if (!open) clearActive(card);
  };

  for (const card of cards) {
    const toggle = card.querySelector<HTMLButtonElement>(".flow-toggle");
    const diagram = card.querySelector<HTMLElement>(".card-diagram");

    toggle?.addEventListener("click", () => {
      setFlow(card, toggle.getAttribute("aria-expanded") !== "true");
    });

    // The trip back: clicking a written step returns to the diagram and lights
    // up the step it came from, so the two halves stay tied together.
    for (const detail of card.querySelectorAll<HTMLElement>("[data-detail-target]")) {
      const jumpToDiagram = () => {
        if (!diagram) return;

        for (const spot of card.querySelectorAll<HTMLElement>("[data-detail]")) {
          spot.classList.toggle("is-active", spot.dataset.detail === detail.dataset.detailTarget);
        }

        diagram.scrollIntoView({ block: "center", behavior: motionOk ? "smooth" : "auto" });
      };

      detail.querySelector<HTMLButtonElement>(".detail-jump")?.addEventListener("click", jumpToDiagram);

      // The whole block is clickable for convenience, but not while the reader
      // is selecting text out of it — a drag-select ends in a click too.
      detail.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        // The jump button handles itself; the evidence link must be allowed to
        // navigate rather than being swallowed by the block-level jump.
        if (target.closest(".detail-jump") || target.closest("a")) return;
        if ((window.getSelection()?.toString() ?? "").length > 0) return;
        jumpToDiagram();
      });
    }

    for (const hotspot of card.querySelectorAll<HTMLElement>("[data-detail]")) {
      const reveal = (event: Event) => {
        event.preventDefault();
        setFlow(card, true);

        const target = card.querySelector<HTMLElement>(
          `[data-detail-target="${hotspot.dataset.detail}"]`
        );
        if (!target) return;

        clearActive(card);
        target.classList.add("is-active");
        target.scrollIntoView({ block: "center", behavior: motionOk ? "smooth" : "auto" });
      };

      hotspot.addEventListener("click", reveal);
      hotspot.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") reveal(event);
      });
    }
  }

  // Changing the filter puts every card back to a vignette — otherwise a card
  // left open and scrolled mid-flow stays that way behind a filter that no
  // longer includes it.
  document.addEventListener("cards:reset", () => {
    for (const card of cards) {
      card.open = false;
      setFlow(card, false);
    }
  });

  for (const link of document.querySelectorAll<HTMLElement>('a[href*="#card-"]')) {
    link.addEventListener("click", (event) => {
      const hrefAttr = link.getAttribute("href");
      if (!hrefAttr) return;

      const hash = new URL(hrefAttr, document.baseURI).hash;
      const targetCard = document.querySelector<HTMLDetailsElement>(hash);
      if (!targetCard) return;

      event.preventDefault();

      const filterButton = document.querySelector<HTMLButtonElement>(
        `.filter button[data-filter="${targetCard.dataset.role}"]`
      );
      filterButton?.click();

      targetCard.open = true;
      targetCard.scrollIntoView({ block: "start", behavior: motionOk ? "smooth" : "auto" });
    });
  }
</script>
