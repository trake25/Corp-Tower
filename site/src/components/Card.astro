---
import VideoSlot from "./VideoSlot.astro";

// Level 2 — a skill card in section 00, directly under the section heading.
// It used to be level 4 (panel → game card → vignette → section); promoting the
// panel out of the game card took two levels off, which is why the headline is
// an h3 and the step titles are h4 rather than the h5/h6 they were pinned to
// when there were two more headings above them.
//
//   1. Vignette — collapsed tile: role chip + summary title only.
//   2. Open     — short description, tools, then diagram → video, with the
//                 written steps collapsed behind their own "Show N steps".
//
// That steps toggle is a second, deliberately small `<details>` nested inside
// the card's own — one click reveals every step at once, same as it always
// has; it just no longer dumps onto the screen the instant the card opens.
// A diagram hotspot click opens it automatically (see the script below), so
// the diagram stays the fast path in either state.
//
// This used to be gone entirely — step bodies are short enough to simply show
// — but the six-card panel got long enough that opening one card was a wall of
// text before a reader had even looked at the diagram. Nesting one more
// `<details>` costs less than that wall did. `details[].body` staying two to
// three sentences is still load-bearing: this toggle reveals all of them at
// once, not one at a time, so length is still what keeps it readable once
// open.
//
// Order inside an open card is deliberate: the diagram gives you the shape, the
// clip shows it running, the steps say why. An absent clip renders nothing.
//
// `links` is intentionally not rendered — the "In the repo" block was removed.
// The data is kept in the card frontmatter so it can be brought back without
// re-collecting two dozen URLs.
interface CardLink {
  label: string;
  href: string;
}

interface CardDetail {
  id: string;
  title: string;
  keywords?: string[];
  body: string;
  evidence?: { label: string; href: string };
  planned?: boolean;
}

interface Props {
  role: string;
  headline: string;
  plain: string;
  tools: string[];
  details: CardDetail[];
  video?: { src: string; poster?: string; caption?: string };
  videos?: { src: string; poster?: string; caption?: string }[];
  hasBody: boolean;
  links?: CardLink[];
}

const { role, headline, plain, tools, details, video, videos, hasBody } = Astro.props;
const hasFlow = details.length > 0;
const roleSlug = role.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const cardId = `card-${roleSlug}`;
---

<details class="card" id={cardId} data-role={role}>
  <summary>
    <span class="role-tag">{role}</span>
    <h3 class="headline">{headline}</h3>
    <span class="toggle-hint">
      <span class="toggle-open">Open</span>
      <span class="toggle-close">Close</span>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
        <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </summary>

  <div class="expanded">
    <p class="plain">{plain}</p>

    {tools.length > 0 && (
      <p class="card-tools">
        <span class="card-tools-label">Tools &amp; tech</span>
        {tools.map((tool) => <span class="tool">{tool}</span>)}
      </p>
    )}

    <slot name="diagram" />

    <VideoSlot video={video} videos={videos} label="Recorded run" />

    {hasFlow && (
      <details class="detail-list-wrap">
        <summary class="detail-list-summary">
          <span class="detail-list-toggle-open">Show {details.length} steps</span>
          <span class="detail-list-toggle-close">Hide steps</span>
          <svg class="detail-list-chevron" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
            <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="detail-list">
          {details.map((detail) => (
            <section class="detail" data-detail-target={detail.id} class:list={{ "is-planned": detail.planned }}>
              <h4>
                <button class="detail-jump" type="button">
                  {detail.title}
                  {detail.planned && <span class="planned-tag">Planned</span>}
                  <span class="detail-jump-hint" aria-hidden="true">↑ diagram</span>
                </button>
              </h4>
              {detail.keywords && detail.keywords.length > 0 && (
                <p class="detail-keywords">
                  {detail.keywords.map((keyword) => <span class="keyword">{keyword}</span>)}
                </p>
              )}
              <p>{detail.body}</p>
              {detail.evidence && (
                <a
                  class="detail-evidence"
                  href={detail.evidence.href}
                  target={detail.evidence.href.includes("#card-") ? undefined : "_blank"}
                  rel={detail.evidence.href.includes("#card-") ? undefined : "noopener noreferrer"}
                >
                  {detail.evidence.label}
                  {detail.evidence.href.includes("#card-") ? (
                    <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
                      <path d="M2.5 6 H9.5 M6 2.5 L9.5 6 L6 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
                      <path d="M3.5 8.5 L8.5 3.5 M8.5 3.5 H4.9 M8.5 3.5 V7.1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                </a>
              )}
            </section>
          ))}
        </div>
      </details>
    )}

    {hasBody && (
      <div class="flow-body">
        <slot />
      </div>
    )}
  </div>
</details>

<script>
  // The steps sit behind their own collapsed `<details>`, so a diagram click
  // has to open that before it can highlight or scroll to anything — a step
  // hidden by a closed disclosure can't be scrolled into view. The return
  // trip lights the diagram box back up. Both halves share `is-active` and
  // are cleared together — a reset must never leave a step lit with nothing
  // selected.
  const motionOk = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cards = document.querySelectorAll<HTMLDetailsElement>(".card");

  const clearActive = (card: HTMLElement) => {
    for (const marked of card.querySelectorAll<HTMLElement>(".is-active")) {
      marked.classList.remove("is-active");
    }
  };

  for (const card of cards) {
    const diagram = card.querySelector<HTMLElement>(".card-diagram");
    const stepsWrap = card.querySelector<HTMLDetailsElement>(".detail-list-wrap");
    const clipsWrap = card.querySelector<HTMLDetailsElement>(".clips-wrap");

    // Closing the card also closes its steps and its clips — reopening the
    // card later should never skip the collapsed state just because it was
    // left open earlier in the same visit. The clips do not re-download: the
    // players keep the `src` they were given on first open.
    card.addEventListener("toggle", () => {
      if (!card.open) {
        if (stepsWrap) stepsWrap.open = false;
        if (clipsWrap) clipsWrap.open = false;
        clearActive(card);
      }
    });

    for (const detail of card.querySelectorAll<HTMLElement>("[data-detail-target]")) {
      const jumpToDiagram = () => {
        if (!diagram) return;

        for (const spot of card.querySelectorAll<HTMLElement>("[data-detail]")) {
          spot.classList.toggle("is-active", spot.dataset.detail === detail.dataset.detailTarget);
        }

        diagram.scrollIntoView({ block: "center", behavior: motionOk ? "smooth" : "auto" });
      };

      detail.querySelector<HTMLButtonElement>(".detail-jump")?.addEventListener("click", jumpToDiagram);

      // The whole block is clickable for convenience, but not while the reader
      // is selecting text out of it — a drag-select ends in a click too.
      detail.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (target.closest(".detail-jump") || target.closest("a")) return;
        if ((window.getSelection()?.toString() ?? "").length > 0) return;
        jumpToDiagram();
      });
    }

    for (const hotspot of card.querySelectorAll<HTMLElement>("[data-detail]")) {
      const reveal = (event: Event) => {
        event.preventDefault();

        const target = card.querySelector<HTMLElement>(
          `[data-detail-target="${hotspot.dataset.detail}"]`
        );
        if (!target) return;

        // The step this hotspot points at may be behind the collapsed steps
        // toggle — open it first, or there's nothing visible to scroll to.
        if (stepsWrap && !stepsWrap.open) stepsWrap.open = true;

        clearActive(card);
        target.classList.add("is-active");
        hotspot.classList.add("is-active");
        target.scrollIntoView({ block: "center", behavior: motionOk ? "smooth" : "auto" });
      };

      hotspot.addEventListener("click", reveal);
      hotspot.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") reveal(event);
      });
    }
  }

  // Changing the filter puts every card back to a vignette — otherwise a card
  // left open and scrolled mid-flow stays that way behind a filter that no
  // longer includes it.
  document.addEventListener("cards:reset", () => {
    for (const card of cards) {
      card.open = false;
      const stepsWrap = card.querySelector<HTMLDetailsElement>(".detail-list-wrap");
      const clipsWrap = card.querySelector<HTMLDetailsElement>(".clips-wrap");
      if (stepsWrap) stepsWrap.open = false;
      if (clipsWrap) clipsWrap.open = false;
      clearActive(card);
    }
  });
</script>
