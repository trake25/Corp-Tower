---
// Everything in <summary> is phrasing content on purpose: <summary> only
// permits phrasing or heading content, so the tool chips and the diagram are
// built from <span>s made block-level in CSS. A <figure> or <div> in here is
// invalid HTML that happens to render.
interface CardLink {
  label: string;
  href: string;
}

interface CardDetail {
  id: string;
  title: string;
  body: string;
}

interface Props {
  role: string;
  headline: string;
  plain: string;
  metric: string;
  metricLabel: string;
  tools: string[];
  details: CardDetail[];
  links: CardLink[];
}

const { role, headline, plain, metric, metricLabel, tools, details, links } = Astro.props;
---

<details class="card" data-role={role}>
  <summary>
    <span class="card-head">
      <span class="role-tag">{role}</span>
      <span class="metric">
        <span class="metric-value">{metric}</span>
        <span class="metric-label">{metricLabel}</span>
      </span>
    </span>
    <h3 class="headline">{headline}</h3>
    <span class="plain">{plain}</span>

    {tools.length > 0 && (
      <span class="card-tools">
        <span class="card-tools-label">Tools &amp; tech</span>
        {tools.map((tool) => <span class="tool">{tool}</span>)}
      </span>
    )}

    <slot name="diagram" />

    <span class="toggle-hint">
      <span class="toggle-open">Read the details</span>
      <span class="toggle-close">Collapse</span>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
        <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </summary>

  <div class="expanded">
    {details.length > 0 && (
      <div class="detail-list">
        {details.map((detail) => (
          <section class="detail" data-detail-target={detail.id}>
            <h4>{detail.title}</h4>
            <p>{detail.body}</p>
          </section>
        ))}
      </div>
    )}

    <slot />

    {links.length > 0 && (
      <div class="proof-links">
        <span class="proof-links-label">In the repo</span>
        <ul>
          {links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</details>

<script>
  // Diagram hotspots live inside <summary>, where any click would normally just
  // toggle the card. So the default is suppressed and the card is forced open
  // instead of toggled — clicking a step should never be able to close the card
  // you are trying to read.
  const motionOk = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const card of document.querySelectorAll<HTMLDetailsElement>(".card")) {
    const targets = card.querySelectorAll<HTMLElement>("[data-detail-target]");

    const reveal = (event: Event, hotspot: HTMLElement) => {
      event.preventDefault();
      event.stopPropagation();
      card.open = true;

      const wanted = hotspot.dataset.detail;
      const target = card.querySelector<HTMLElement>(`[data-detail-target="${wanted}"]`);
      if (!target) return;

      for (const other of targets) other.classList.remove("is-active");
      target.classList.add("is-active");
      target.scrollIntoView({ block: "center", behavior: motionOk ? "smooth" : "auto" });
    };

    for (const hotspot of card.querySelectorAll<HTMLElement>("[data-detail]")) {
      hotspot.addEventListener("click", (event) => reveal(event, hotspot));
      hotspot.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") reveal(event, hotspot);
      });
    }
  }
</script>
