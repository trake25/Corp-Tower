---
import CardFilter from "./CardFilter.astro";

// The skill cards and the control that filters them. A plain body, not a
// disclosure: `#engineering` owns it directly and it must not be nested back
// inside a game card (site/docs/design.md). The progressive disclosure that
// matters — card, then steps — lives one and two levels below.
//
// The role filter stays here, next to the skills. The `cards:reset` event it
// dispatches is handled by Card.astro.
interface Props {
  roles: string[];
  total: number;
  intro?: string;
}

const { roles, total, intro } = Astro.props;
---

<div class="building" id="building-the-game">
  {intro && <p class="building-intro">{intro}</p>}
  <CardFilter roles={roles} total={total} />
  <!-- One skill card open at a time, stacked in a single column. index.astro's
       [data-accordion] handler closes the siblings and hides them outright, so
       an open card is read against blank space rather than wedged between five
       closed titles. -->
  <div class="cards" data-accordion="true">
    <slot />
  </div>
</div>
