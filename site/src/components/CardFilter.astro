---
interface Props {
  roles: string[];
  total: number;
}

const { roles, total } = Astro.props;
---

<div class="filter-bar">
  <div class="filter" role="group" aria-label="Filter skills by discipline">
    <button type="button" data-filter="all" aria-pressed="true">All</button>
    {roles.map((role) => (
      <button type="button" data-filter={role} aria-pressed="false">{role}</button>
    ))}
  </div>
  <p class="filter-count" role="status" aria-live="polite" data-total={total}>
    Showing all {total} skills
  </p>
</div>

<script>
  const filterEl = document.querySelector<HTMLElement>(".filter");
  const countEl = document.querySelector<HTMLElement>(".filter-count");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".card"));
  const total = Number(countEl?.dataset.total ?? cards.length);

  filterEl?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-filter]");
    if (!button) return;

    const selected = button.dataset.filter ?? "all";

    filterEl.querySelectorAll<HTMLButtonElement>("button[data-filter]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b === button));
    });

    let shown = 0;
    for (const card of cards) {
      const show = selected === "all" || card.dataset.role === selected;
      card.hidden = !show;
      if (show) shown += 1;
    }

    if (countEl) {
      countEl.textContent =
        selected === "all"
          ? `Showing all ${total} skills`
          : `Showing ${shown} of ${total} — ${selected}`;
    }
  });
</script>
