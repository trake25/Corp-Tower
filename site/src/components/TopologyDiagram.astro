---
// Hand-authored, not generated — kept intentionally simple: one client, three
// independently-deployed environments, same container image everywhere.
// Source facts: docs/context/deployment.md, docs/context/architecture.md.
---

<svg
  viewBox="0 0 820 400"
  role="img"
  aria-labelledby="topology-title topology-desc"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  stroke="currentColor"
>
  <title id="topology-title">Corp Tower deployment topology</title>
  <desc id="topology-desc">
    A single Godot client connects over WebSocket to one of three independently
    deployed environments running the same container image: K3s production and
    test, running continuously; EKS, a session-scoped validation stack brought
    up on demand and torn down after; and a physical backup machine running dev
    instances plus the always-on public demo. K3s uses an in-cluster Redis, EKS
    uses ElastiCache over rediss, and the backup machine runs no Redis at all.
  </desc>

  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="currentColor" stroke="none" />
    </marker>
  </defs>

  <!-- Client -->
  <rect x="16" y="164" width="148" height="72" rx="10" stroke-width="1.5" />
  <text x="90" y="194" text-anchor="middle" font-size="14" font-weight="700" stroke="none" fill="currentColor">Player</text>
  <text x="90" y="212" text-anchor="middle" font-size="11" stroke="none" fill="currentColor" opacity="0.75">Godot client</text>
  <text x="90" y="226" text-anchor="middle" font-size="11" stroke="none" fill="currentColor" opacity="0.75">Android / Web</text>

  <!-- Lines client -> each environment -->
  <path d="M164,190 C 210,190 210,58 264,58" stroke-width="1.5" marker-end="url(#arrow)" />
  <path d="M164,200 L 264,200" stroke-width="1.5" marker-end="url(#arrow)" />
  <path d="M164,210 C 210,210 210,342 264,342" stroke-width="1.5" marker-end="url(#arrow)" />

  <text x="205" y="120" text-anchor="middle" font-size="10" stroke="none" fill="currentColor" opacity="0.6">wss://</text>

  <!-- K3s (production) -->
  <rect x="264" y="18" width="270" height="80" rx="10" stroke-width="1.5" />
  <text x="278" y="42" font-size="13" font-weight="700" stroke="none" fill="currentColor">K3s — production + test</text>
  <text x="278" y="60" font-size="11" stroke="none" fill="currentColor" opacity="0.75">EC2, Caddy gateway, always on</text>
  <text x="278" y="76" font-size="11" stroke="none" fill="currentColor" opacity="0.75">Redis: in-cluster</text>
  <rect x="264" y="18" width="270" height="80" rx="10" stroke-width="1.5" fill="none" />

  <!-- EKS (session-scoped) -->
  <rect x="264" y="160" width="270" height="80" rx="10" stroke-width="1.5" stroke-dasharray="5 4" />
  <text x="278" y="184" font-size="13" font-weight="700" stroke="none" fill="currentColor">EKS — validation</text>
  <text x="278" y="202" font-size="11" stroke="none" fill="currentColor" opacity="0.75">ALB, managed nodes, session-scoped</text>
  <text x="278" y="218" font-size="11" stroke="none" fill="currentColor" opacity="0.75">Redis: ElastiCache (rediss://)</text>

  <!-- Physical backup (dev + demo) -->
  <rect x="264" y="302" width="270" height="80" rx="10" stroke-width="1.5" />
  <text x="278" y="326" font-size="13" font-weight="700" stroke="none" fill="currentColor">Physical backup — dev + demo</text>
  <text x="278" y="344" font-size="11" stroke="none" fill="currentColor" opacity="0.75">Cloudflare Tunnel, always on</text>
  <text x="278" y="360" font-size="11" stroke="none" fill="currentColor" opacity="0.75">Redis: none (in-memory)</text>

  <!-- shared-image bracket -->
  <path d="M552,30 L568,30 L568,370 L552,370" stroke-width="1.5" stroke-dasharray="2 3" />
  <text x="580" y="205" font-size="11" stroke="none" fill="currentColor" opacity="0.75" transform="rotate(90 580 205)" text-anchor="middle">same container image, every environment</text>
</svg>
