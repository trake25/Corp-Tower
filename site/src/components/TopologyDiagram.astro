---
// Hand-authored, not generated — kept intentionally simple: one client, three
// independently-deployed targets, same container image everywhere.
// Source facts: docs/context/deployment.md, docs/context/architecture.md.
// Colour comes from the classes below so the diagram tracks the site theme.
import { profile } from "../data/profile";
---

<svg
  class="topology"
  viewBox="0 0 820 400"
  role="img"
  aria-labelledby="topology-title topology-desc"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
>
  <title id="topology-title">{profile.project} deployment topology</title>
  <desc id="topology-desc">
    A single Godot client connects over WebSocket to one of three independently
    deployed targets running the same container image. EKS is the
    production-grade target: an application load balancer, managed nodes in
    private subnets and ElastiCache over rediss, brought up for a session and
    destroyed after it. K3s on a single EC2 instance is the lab where changes
    are tested and learned on, running continuously with an in-cluster Redis.
    A physical backup machine behind a Cloudflare Tunnel is the cost-efficient
    development target, and also serves the public demo; it runs no managed
    services and keeps state in memory.
  </desc>

  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="arrow-head" d="M0,0 L10,5 L0,10 z" stroke="none" />
    </marker>
  </defs>

  <!-- Client -->
  <rect class="node" x="16" y="164" width="148" height="72" rx="10" />
  <text class="label" x="90" y="194" text-anchor="middle">Player</text>
  <text class="sub" x="90" y="212" text-anchor="middle">Godot client</text>
  <text class="sub" x="90" y="226" text-anchor="middle">Android / Web</text>

  <!-- Lines client -> each target -->
  <path class="link" d="M164,190 C 210,190 210,58 264,58" marker-end="url(#arrow)" />
  <path class="link" d="M164,200 L 264,200" marker-end="url(#arrow)" />
  <path class="link" d="M164,210 C 210,210 210,342 264,342" marker-end="url(#arrow)" />

  <text class="wire" x="205" y="120" text-anchor="middle">wss://</text>

  <!-- EKS — the production-grade target -->
  <rect class="node ephemeral" x="264" y="18" width="270" height="80" rx="10" />
  <text class="label" x="278" y="42">EKS — production grade</text>
  <text class="sub" x="278" y="60">ALB, managed nodes, private subnets</text>
  <text class="sub" x="278" y="76">Session-scoped · managed Redis (TLS)</text>

  <!-- K3s — the lab -->
  <rect class="node" x="264" y="160" width="270" height="80" rx="10" />
  <text class="label" x="278" y="184">K3s — lab</text>
  <text class="sub" x="278" y="202">Single EC2, Caddy gateway, always on</text>
  <text class="sub" x="278" y="218">Test and learn · Redis in-cluster</text>

  <!-- Physical backup — cost-efficient dev, and the public demo -->
  <rect class="node" x="264" y="302" width="270" height="80" rx="10" />
  <text class="label" x="278" y="326">Backup machine — dev + demo</text>
  <text class="sub" x="278" y="344">Cost-efficient development target</text>
  <text class="sub" x="278" y="360">Cloudflare Tunnel · Redis in-memory</text>

  <!-- shared-image bracket -->
  <path class="bracket" d="M552,30 L568,30 L568,370 L552,370" />
  <text class="wire accent" x="580" y="205" transform="rotate(90 580 205)" text-anchor="middle">same container image, every target</text>
</svg>
