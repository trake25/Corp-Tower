---
// Hand-authored, not generated — kept intentionally simple: one client, three
// independently-deployed environments, same container image everywhere.
// Source facts: docs/context/deployment.md, docs/context/architecture.md.
// Colour comes from the classes below so the diagram tracks the site theme.
---

<svg
  class="topology"
  viewBox="0 0 820 400"
  role="img"
  aria-labelledby="topology-title topology-desc"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
>
  <title id="topology-title">Corp Tower deployment topology</title>
  <desc id="topology-desc">
    A single Godot client connects over WebSocket to one of three independently
    deployed environments running the same container image: K3s production and
    test, running continuously; EKS, a session-scoped validation stack brought
    up on demand and torn down after; and a physical backup machine running dev
    instances plus the always-on public demo. K3s uses an in-cluster Redis, EKS
    uses ElastiCache over rediss, and the backup machine runs no Redis at all.
  </desc>

  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="arrow-head" d="M0,0 L10,5 L0,10 z" stroke="none" />
    </marker>
  </defs>

  <!-- Client -->
  <rect class="node" x="16" y="164" width="148" height="72" rx="10" />
  <text class="label" x="90" y="194" text-anchor="middle">Player</text>
  <text class="sub" x="90" y="212" text-anchor="middle">Godot client</text>
  <text class="sub" x="90" y="226" text-anchor="middle">Android / Web</text>

  <!-- Lines client -> each environment -->
  <path class="link" d="M164,190 C 210,190 210,58 264,58" marker-end="url(#arrow)" />
  <path class="link" d="M164,200 L 264,200" marker-end="url(#arrow)" />
  <path class="link" d="M164,210 C 210,210 210,342 264,342" marker-end="url(#arrow)" />

  <text class="wire" x="205" y="120" text-anchor="middle">wss://</text>

  <!-- K3s (production + test) -->
  <rect class="node" x="264" y="18" width="270" height="80" rx="10" />
  <text class="label" x="278" y="42">K3s — production + test</text>
  <text class="sub" x="278" y="60">EC2, Caddy gateway, always on</text>
  <text class="sub" x="278" y="76">Redis: in-cluster</text>

  <!-- EKS (session-scoped) -->
  <rect class="node ephemeral" x="264" y="160" width="270" height="80" rx="10" />
  <text class="label" x="278" y="184">EKS — validation</text>
  <text class="sub" x="278" y="202">ALB, managed nodes, session-scoped</text>
  <text class="sub" x="278" y="218">Redis: ElastiCache (rediss://)</text>

  <!-- Physical backup (dev + demo) -->
  <rect class="node" x="264" y="302" width="270" height="80" rx="10" />
  <text class="label" x="278" y="326">Physical backup — dev + demo</text>
  <text class="sub" x="278" y="344">Cloudflare Tunnel, always on</text>
  <text class="sub" x="278" y="360">Redis: none (in-memory)</text>

  <!-- shared-image bracket -->
  <path class="bracket" d="M552,30 L568,30 L568,370 L552,370" />
  <text class="wire accent" x="580" y="205" transform="rotate(90 580 205)" text-anchor="middle">same container image, every environment</text>
</svg>
