---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
---

<BaseLayout title={`Not found — ${profile.name}`} description="Page not found.">
  <main id="main">
    <section class="hero">
      <p class="eyebrow">404</p>
      <h1>That page doesn't exist.</h1>
      <p class="lede">
        Nothing here. The games, the playable demo and the engineering behind
        them are all one link away.
      </p>
      <div class="ctas">
        <a class="cta primary" href="/#playables">Go and play something</a>
        <a class="cta secondary" href="/#games">See the games</a>
      </div>
    </section>
  </main>
</BaseLayout>
