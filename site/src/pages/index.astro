  .facts {
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    max-width: 62ch;
  }

  .facts > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .facts dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .facts dd {
    margin: 0;
    line-height: 1.55;
  }

  @media (max-width: 34rem) {
    .facts > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
