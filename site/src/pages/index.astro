---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CardFilter from "../components/CardFilter.astro";
import Card from "../components/Card.astro";
import CloudTargetsDiagram from "../components/diagrams/CloudTargetsDiagram.astro";
import QaLoopDiagram from "../components/diagrams/QaLoopDiagram.astro";
import AiWorkflowDiagram from "../components/diagrams/AiWorkflowDiagram.astro";
import DevOpsPipelineDiagram from "../components/diagrams/DevOpsPipelineDiagram.astro";
import BackendEngineeringDiagram from "../components/diagrams/BackendEngineeringDiagram.astro";
import FrontendEngineeringDiagram from "../components/diagrams/FrontendEngineeringDiagram.astro";
import { profile } from "../data/profile";

// One showcase diagram per skill, keyed by the card's `role`. A role with no
// entry here simply renders without one, so adding the remaining diagrams is a
// one-line change per skill.
const diagrams: Record<string, typeof QaLoopDiagram | undefined> = {
  Cloud: CloudTargetsDiagram,
  QA: QaLoopDiagram,
  AI: AiWorkflowDiagram,
  DevOps: DevOpsPipelineDiagram,
  Backend: BackendEngineeringDiagram,
  Frontend: FrontendEngineeringDiagram,
};

// Filter buttons follow this order, not the cards' display order. A role present
// in the cards but missing here is appended rather than dropped.
const ROLE_ORDER = ["QA", "AI", "Cloud", "DevOps", "Backend", "Frontend"];

const cardEntries = (await getCollection("cards")).sort((a, b) => a.data.order - b.data.order);
const presentRoles = [...new Set(cardEntries.map((entry) => entry.data.role))];
const roles = [
  ...ROLE_ORDER.filter((role) => presentRoles.includes(role)),
  ...presentRoles.filter((role) => !ROLE_ORDER.includes(role)),
];

const year = new Date().getFullYear();

const rendered = await Promise.all(
  cardEntries.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);
---

<BaseLayout
  title={`${profile.name} — ${profile.jobTitle}`}
  description={`I design, build, QA and operate ${profile.project} (${profile.projectShort}), a real-time multiplayer game on Android and browser, end to end. Six skills, each with the code that proves it.`}
>
  <header class="site-header">
    <a class="wordmark" href="/">
      <span class="wordmark-mark" aria-hidden="true"></span>
      {profile.name}
    </a>
    <nav aria-label="Primary">
      <a href="#skills">Skills</a>
      <a href="#work">Work with me</a>
      <a href={profile.repo} target="_blank" rel="noopener noreferrer">Code</a>
      <a class="nav-cta" href="#contact">Contact</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <p class="eyebrow">{profile.title}</p>
      <h1>
        Orchestrators control.<br class="hero-break" />
        Agents accelerate.
      </h1>
      <p class="lede">
        <strong>{profile.project} ({profile.projectShort})</strong> is a real-time
        multiplayer game where three players cooperate to build a tower — and still
        compete to outscore each other. I design, build, quality-assure and operate all of
        it: the game, the servers under it, and the pipeline that ships it.
      </p>

      <dl class="facts">
        <div>
          <dt>Stack</dt>
          <dd>Godot client, server-authoritative Node.js and Redis backend.</dd>
        </div>
        <div>
          <dt>Playable</dt>
          <dd>In the browser today. Android build in an internal testing track.</dd>
        </div>
        <div>
          <dt>Deploys</dt>
          <dd>
            One container image, three targets: EKS for production-grade, K3s as the lab,
            a machine at home as the cheap dev target.
          </dd>
        </div>
        <div>
          <dt>Agents</dt>
          <dd>They do the implementing. I hold the requirement, the review and the sign-off.</dd>
        </div>
      </dl>

      <div class="ctas">
        <a class="cta primary" href={profile.demo} target="_blank" rel="noopener noreferrer">
          Play the demo
        </a>
        <a class="cta secondary" href={profile.repo} target="_blank" rel="noopener noreferrer">
          Read the source
        </a>
        <a class="cta ghost" href="#skills">Skip to the skills</a>
      </div>

      <details class="demo-notes">
        <summary>Before you play: three things to know</summary>
        <ul>
          <li>Bots fill empty seats, so one visitor still gets a full round. The real game is three humans.</li>
          <li>It runs from the dev environment to keep costs down, so latency is higher than production.</li>
          <li>Still in development. Things will change.</li>
        </ul>
      </details>
    </section>

    <section id="skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="section-title">
        <span class="section-index">01</span> Skills highlights
      </h2>
      <p class="section-intro">
        Open a card for the proof. Inside, click any step in the diagram to jump straight
        to the code that runs it.
      </p>

      <CardFilter roles={roles} total={cardEntries.length} />

      <div class="cards">
        {rendered.map(({ entry, Content }) => {
          const Diagram = diagrams[entry.data.role];
          return (
            <Card
              role={entry.data.role}
              headline={entry.data.headline}
              plain={entry.data.plain}
              tools={entry.data.tools}
              details={entry.data.details}
              hasBody={entry.body.trim().length > 0}
              links={entry.data.links}
            >
              {Diagram && <Diagram slot="diagram" />}
              <Content />
            </Card>
          );
        })}
      </div>
    </section>

    <section id="work" aria-labelledby="work-heading">
      <h2 id="work-heading" class="section-title">
        <span class="section-index">02</span> Work with me
      </h2>
      <div class="services">
        <article class="service">
          <h3>Cloud &amp; platform engineering</h3>
          <p>
            Terraform-managed Kubernetes on EC2 or EKS, private networking, TLS and DNS.
            Cost bounded by design, not by an alert that arrives a day late.
          </p>
        </article>
        <article class="service">
          <h3>Delivery automation &amp; guardrails</h3>
          <p>
            Pipelines that verify their own output, drift checks that fail before a build
            starts, and destructive operations that demand a typed confirmation.
          </p>
        </article>
        <article class="service">
          <h3>AI-assisted delivery, done properly</h3>
          <p>
            Agents implementing against written acceptance criteria, with a rejection path
            and CI gates cleared before a human looks — plus the retrieval layer that keeps
            them oriented in your codebase.
          </p>
        </article>
      </div>

      <div class="how-i-work">
        <h3>How I work with coding agents</h3>
        <p>
          I brief an agent the way you'd brief a contractor: requirement written down
          first, work tested against it, sent back with specifics until nothing is
          outstanding. I read every language in this repository fluently — Node.js on the
          server, GDScript in the client — because when the agent stalls, the work still
          has to move.
        </p>
      </div>
    </section>

    <section id="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="section-title">
        <span class="section-index">03</span> Get in touch
      </h2>
      {profile.availability && <p class="availability">{profile.availability}</p>}
      <div class="contact-links">
        <a class="cta primary" href={`mailto:${profile.email}`}>{profile.email}</a>
        {profile.linkedin && (
          <a class="cta secondary" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        )}
        <a class="cta secondary" href={profile.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-top">
      <p class="footer-id">
        <strong>{profile.name}</strong>
        <span>{profile.title}{profile.location && ` · ${profile.location}`}</span>
      </p>
      <nav class="footer-nav" aria-label="Footer">
        <a href="#skills">Skills</a>
        <a href="#work">Work with me</a>
        <a href="#contact">Contact</a>
        <a href={profile.demo} target="_blank" rel="noopener noreferrer">Play the demo</a>
        <a href={profile.repo} target="_blank" rel="noopener noreferrer">Source</a>
      </nav>
    </div>
    <p class="footer-note">
      Every claim here links to the file, workflow or test behind it. The repository still
      carries the project's working name, Corp&nbsp;Tower.
    </p>
    <p class="footer-meta">
      © {year} {profile.name} · Static Astro build, redeployed to Cloudflare Workers on
      every push.
    </p>
  </footer>
</BaseLayout>

<style>
  /* Hero spec list: replaces two long prose paragraphs with scannable rows. */
  .facts {
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    max-width: 62ch;
  }

  .facts > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .facts dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .facts dd {
    margin: 0;
    line-height: 1.55;
  }

  @media (max-width: 34rem) {
    .facts > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  /* Demo caveats: present for anyone who wants them, silent for everyone else. */
  .demo-notes {
    margin-top: 1.75rem;
    max-width: 62ch;
    font-size: 0.9rem;
    opacity: 0.75;
  }

  .demo-notes summary {
    cursor: pointer;
    width: fit-content;
  }

  .demo-notes ul {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
  }
</style>
