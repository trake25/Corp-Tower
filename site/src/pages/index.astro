---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CardFilter from "../components/CardFilter.astro";
import Card from "../components/Card.astro";
import CloudTargetsDiagram from "../components/diagrams/CloudTargetsDiagram.astro";
import QaLoopDiagram from "../components/diagrams/QaLoopDiagram.astro";
import { profile } from "../data/profile";

// One showcase diagram per skill, keyed by the card's `role`. A role with no
// entry here simply renders without one, so adding the remaining diagrams is a
// one-line change per skill.
const diagrams: Record<string, typeof QaLoopDiagram | undefined> = {
  Cloud: CloudTargetsDiagram,
  QA: QaLoopDiagram,
};

// Filter buttons follow this order, not the cards' display order. A role present
// in the cards but missing here is appended rather than dropped.
const ROLE_ORDER = ["QA", "AI", "Cloud", "DevOps", "Backend", "Frontend"];

const cardEntries = (await getCollection("cards")).sort((a, b) => a.data.order - b.data.order);
const presentRoles = [...new Set(cardEntries.map((entry) => entry.data.role))];
const roles = [
  ...ROLE_ORDER.filter((role) => presentRoles.includes(role)),
  ...presentRoles.filter((role) => !ROLE_ORDER.includes(role)),
];

const year = new Date().getFullYear();

const rendered = await Promise.all(
  cardEntries.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);
---

<BaseLayout
  title={`${profile.name} — ${profile.jobTitle}`}
  description={`I design, build, QA and operate ${profile.project} (${profile.projectShort}), a real-time multiplayer game on Android and browser, end to end. Six skills, each with the code that proves it.`}
>
  <header class="site-header">
    <a class="wordmark" href="/">
      <span class="wordmark-mark" aria-hidden="true"></span>
      {profile.name}
    </a>
    <nav aria-label="Primary">
      <a href="#skills">Skills</a>
      <a href="#work">Work with me</a>
      <a href={profile.repo} target="_blank" rel="noopener noreferrer">Code</a>
      <a class="nav-cta" href="#contact">Contact</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <p class="eyebrow">{profile.title}</p>
      <h1>
        In a world of automation,<br class="hero-break" />
        quality and cost efficiency are what I bring.
      </h1>
      <p class="lede">
        <strong>{profile.project} ({profile.projectShort})</strong> is a real-time,
        server-authoritative multiplayer game, currently in development. It's a
        selfish-cooperative social game: players have to cooperate to build a tower and
        complete each level, while still trying to outscore one another. The demo runs in
        the browser today, with an Android build in an internal testing track and more
        platforms to follow. I design, orchestrate, build, quality-assure and run it end to
        end: the servers and infrastructure it runs on, the game logic, the UI integration
        into the client, and the pipeline that ships all of it. Coding agents do a lot of
        the implementing; I hold the requirement, the review and the sign-off.
      </p>
      <p class="lede">
        Underneath: a Godot client, a server that holds the only authoritative copy of the
        game, and three deployment targets built from one container image — EKS for
        production-grade infrastructure, a K3s box as the lab, and a machine at home as the
        cost-efficient development target.
      </p>

      <p class="stack-line">
        Claude · Codex · Cursor · Git / GitHub · Linux · Terraform ·
        Kubernetes (EKS / K3s) · AWS · Docker · GitHub Actions · Cloudflare ·
        Node.js · Redis · Godot / GDScript · Ansible · Google (Cloud / Play / APIs)
      </p>

      <div class="ctas">
        <a class="cta primary" href={profile.demo} target="_blank" rel="noopener noreferrer">
          Play Demo
        </a>
        <a class="cta secondary" href={profile.repo} target="_blank" rel="noopener noreferrer">
          Read the source
        </a>
        <a class="cta ghost" href="#skills">Skip to the skills</a>
      </div>
      <p class="disclosure">
        The demo fills empty seats with bots so a lone visitor still gets a full round —
        the real game is three human players. It is served from the development
        environment to keep costs down, so expect higher latency than the production stack
        would give you. The game is still in development, and things will change.
      </p>
    </section>

    <section id="skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="section-title">
        <span class="section-index">01</span> Skills highlights
      </h2>
      <p class="section-intro">
        Check how skills were demonstrated by opening a card. Inside, click any step in
        the diagram to jump straight to what that part of the flow actually does.
      </p>

      <CardFilter roles={roles} total={cardEntries.length} />

      <div class="cards">
        {rendered.map(({ entry, Content }) => {
          const Diagram = diagrams[entry.data.role];
          return (
            <Card
              role={entry.data.role}
              headline={entry.data.headline}
              plain={entry.data.plain}
              tools={entry.data.tools}
              details={entry.data.details}
              links={entry.data.links}
            >
              {Diagram && <Diagram slot="diagram" />}
              <Content />
            </Card>
          );
        })}
      </div>
    </section>

    <section id="work" aria-labelledby="work-heading">
      <h2 id="work-heading" class="section-title">
        <span class="section-index">02</span> Work with me
      </h2>
      <div class="services">
        <article class="service">
          <h3>Cloud &amp; platform engineering</h3>
          <p>
            Terraform roots, Kubernetes on EC2 or EKS, private networking, TLS and DNS,
            cost bounded by design rather than by an alert that arrives a day late.
          </p>
        </article>
        <article class="service">
          <h3>Delivery automation &amp; guardrails</h3>
          <p>
            Release pipelines that verify their own output, drift checks that fail before
            a build starts, and destructive operations that require a typed confirmation
            naming the exact target.
          </p>
        </article>
        <article class="service">
          <h3>AI-assisted delivery, done properly</h3>
          <p>
            Agents in the implementer's seat with written acceptance criteria, a rejection
            path, and CI gates cleared before a human looks. Plus the retrieval layer that
            lets an agent work in your codebase without re-reading it every session.
          </p>
        </article>
      </div>

      <div class="how-i-work">
        <h3>How I work with coding agents</h3>
        <p>
          I treat an agent the way an organisation treats a contractor: the requirement is
          written down first, the work is tested against it, and it comes back with
          specifics until nothing is outstanding. Every language in this repository is one
          I read fluently — Node.js on the server, GDScript in the client — because when
          the agent stalls, the work has to continue. That's a deliberate constraint, not
          an accident of what was fastest to generate.
        </p>
      </div>
    </section>

    <section id="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="section-title">
        <span class="section-index">03</span> Get in touch
      </h2>
      {profile.availability && <p class="availability">{profile.availability}</p>}
      <div class="contact-links">
        <a class="cta primary" href={`mailto:${profile.email}`}>{profile.email}</a>
        {profile.linkedin && (
          <a class="cta secondary" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        )}
        <a class="cta secondary" href={profile.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-top">
      <p class="footer-id">
        <strong>{profile.name}</strong>
        <span>{profile.title}{profile.location && ` · ${profile.location}`}</span>
      </p>
      <nav class="footer-nav" aria-label="Footer">
        <a href="#skills">Skills</a>
        <a href="#work">Work with me</a>
        <a href="#contact">Contact</a>
        <a href={profile.demo} target="_blank" rel="noopener noreferrer">Play the demo</a>
        <a href={profile.repo} target="_blank" rel="noopener noreferrer">Source</a>
      </nav>
    </div>
    <p class="footer-note">
      Every claim on this page links to the file, workflow or test that backs it. The
      repository still carries the project's working name, Corp&nbsp;Tower.
    </p>
    <p class="footer-meta">
      © {year} {profile.name} · Static Astro build, redeployed to Cloudflare Workers on
      every push.
    </p>
  </footer>
</BaseLayout>
