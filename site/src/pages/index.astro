---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Playables from "../components/Playables.astro";
import Vignette from "../components/Vignette.astro";
import GameCard from "../components/GameCard.astro";
import CvCard from "../components/CvCard.astro";
import BuildingTheGame from "../components/BuildingTheGame.astro";
import Card from "../components/Card.astro";
import ContactDialog from "../components/ContactDialog.astro";
import CloudTargetsDiagram from "../components/diagrams/CloudTargetsDiagram.astro";
import QaLoopDiagram from "../components/diagrams/QaLoopDiagram.astro";
import AiWorkflowDiagram from "../components/diagrams/AiWorkflowDiagram.astro";
import DevOpsPipelineDiagram from "../components/diagrams/DevOpsPipelineDiagram.astro";
import EngineeringWorkflowDiagram from "../components/diagrams/EngineeringWorkflowDiagram.astro";
import { profile } from "../data/profile";

// One diagram per role. A role with no entry here renders without one.
const diagrams: Record<string, typeof QaLoopDiagram | undefined> = {
  Cloud: CloudTargetsDiagram,
  QA: QaLoopDiagram,
  AI: AiWorkflowDiagram,
  DevOps: DevOpsPipelineDiagram,
};

// Filter button order, not the cards' display order. Cloud and DevOps lead
// because that is what the target roles hire for. A role present in the cards
// but missing here is appended rather than dropped.
const ROLE_ORDER = ["Cloud", "DevOps", "QA", "AI"];

// The recruiter layer: a plain-English capability with its implementation named
// in the same row. Copy rules are site/docs/content.md.
const WHAT_I_DO = [
  {
    title: "Build the platform",
    description: "I build the cloud infrastructure applications run on, with security and cost controls built in.",
    tech: "Cloud · AWS · Terraform · Kubernetes · Docker",
  },
  {
    title: "Automate delivery",
    description: "I turn code changes into tested deployments instead of relying on manual release steps.",
    tech: "GitHub Actions · CI/CD · OIDC · Deployment gates",
  },
  {
    title: "Keep systems reliable",
    description: "I test software and infrastructure before changes reach users.",
    tech: "QA · Automated testing · Regression testing · Network operations",
  },
  {
    title: "Use AI to accelerate engineering",
    description: "I use AI agents to do implementation work faster while I keep control of the design, review and final decision.",
    tech: "AI agents · Context engineering · Model selection",
  },
];

// The flat enumeration a scanning reader and an applicant tracking system need.
// Every entry must be something actually used — nothing aspirational.
const SKILL_GROUPS: { label: string; items: string[] }[] = [
  {
    label: "Cloud & infrastructure",
    items: [
      "AWS (EKS, EC2, ElastiCache, S3, IAM)",
      "Terraform",
      "Kubernetes",
      "Docker",
      "Cloudflare (Tunnel, R2, Workers)",
      "Linux",
    ],
  },
  {
    label: "CI/CD & automation",
    items: [
      "GitHub Actions",
      "Composite actions",
      "Jenkins",
      "OIDC federated CI identity",
      "Gated multi-environment deploys",
      "Artifact hash verification",
      "Google Play Publisher API",
      "Git / GitHub",
    ],
  },
  {
    label: "Languages & runtimes",
    items: [
      "Node.js",
      "Python",
      "Bash",
      "GDScript",
      "Java / Kotlin",
      "C#",
      "Redis",
      "WebSocket (ws)",
    ],
  },
  {
    label: "Client & game",
    items: ["Godot 4", "Android builds & signing", "Google Play Console"],
  },
  {
    label: "Security & access",
    items: [
      "IAM policy scoping",
      "Short-lived credentials",
      "Secrets management",
      "Zero Trust access (Okta, Twingate)",
    ],
  },
  {
    label: "QA & testing",
    items: [
      "Test plan & test case design",
      "Functional & regression testing",
      "Exploratory testing",
      "GUT (Godot)",
      "Node.js test runner",
      "Jira",
      "TestRail",
      "Confluence",
    ],
  },
  {
    label: "Networking & operations",
    items: [
      "NOC operations",
      "Incident & escalation management",
      "Cisco",
      "HP Aruba",
      "SD-WAN (Nokia–Huawei)",
      "VoIP",
      "IPVPN",
      "METRO-E",
      "DIA",
      "WAN / LAN / WLAN",
      "SDH transmission",
      "3G / LTE provisioning",
      "NMS alarm monitoring",
      "Fault isolation & failover",
      "High-availability design",
      "BERT / OTDR",
      "CLI / SSH",
    ],
  },
  {
    label: "AI-assisted engineering",
    items: [
      "Claude Code",
      "Codex",
      "Cursor",
      "MCP tool servers",
      "Prompt & context engineering",
      "Retrieval-augmented generation",
    ],
  },
];

// Renders as flat rows, not tiles — see the level grammar in site/docs/design.md.
// Annotated rather than inferred: only one entry carries a `note`, and without
// this TypeScript infers a union the optional field is missing from.
const CREDENTIALS: {
  kind: string;
  title: string;
  issuer: string;
  dates: string;
  note?: string;
}[] = [
  {
    kind: "Degree",
    title: "BS Electronics and Communications Engineering",
    issuer: "University of the East",
    dates: "2008 — 2014",
  },
  {
    kind: "Licence",
    title: "Licensed Electronics Engineer",
    issuer: "Professional Regulation Commission (PRC), Philippines",
    dates: "Oct 2014",
  },
  {
    kind: "Training",
    title: "Nokia-Huawei SD-WAN",
    issuer: "Globe Telecom",
    dates: "Apr 2018",
    note: "32 hours, covering virtual WAN operations.",
  },
];

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

// `hidden: true` entries stay validated but unpublished. Every count, filter
// and grid derives from these three lists, so nothing else has to know.
const cardEntries = (await getCollection("cards", ({ data }) => !data.hidden)).sort(byOrder);
const gameEntries = (await getCollection("games", ({ data }) => !data.hidden)).sort(byOrder);
const cvEntries = (await getCollection("cv", ({ data }) => !data.hidden)).sort(byOrder);

const presentRoles = [...new Set(cardEntries.map((entry) => entry.data.role))];
const roles = [
  ...ROLE_ORDER.filter((role) => presentRoles.includes(role)),
  ...presentRoles.filter((role) => !ROLE_ORDER.includes(role)),
];

const renderedCards = await Promise.all(
  cardEntries.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);
const renderedGames = await Promise.all(
  gameEntries.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);
const featuredRenderedGame = renderedGames.find(
  ({ entry }) => entry.data.title === "Top or Drop"
);
const renderedCv = await Promise.all(
  cvEntries.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);

const inProduction = renderedGames.filter((game) => game.entry.data.status === "production");
const inDevelopment = renderedGames.filter((game) => game.entry.data.status === "development");

// The hero's play button, derived from the game carrying the skill cards.
// No game with links, no button.
const featuredGame =
  gameEntries.find((entry) => entry.data.buildingTheGame) ??
  inDevelopment[0]?.entry ??
  gameEntries[0];
const demoLink = featuredGame?.data.links[0];

// A profile link with no URL yet is a placeholder waiting for one, not a button.
const contactLinks = profile.links.filter(
  (link): link is { label: string; href: string } => Boolean(link.href)
);

const year = new Date().getFullYear();
---

<BaseLayout
  title={`${profile.name} — ${profile.jobTitle}`}
  description={`${profile.jobTitle} in ${profile.location}. Five years of enterprise network operations, then software QA, now platform and DevOps. A deploy-on-demand AWS environment, a gated CI/CD pipeline to five destinations, and ${profile.project} — a real-time multiplayer game you can play, with the source behind it.`}
>
  <header class="site-header">
    <a class="wordmark" href="/">
      <span class="wordmark-mark" aria-hidden="true"></span>
      {profile.name}
    </a>
    <nav aria-label="Primary">
      <a href="#engineering">Engineering</a>
      <a href="#projects">Projects</a>
      <a href="#cv">CV</a>
      <a class="nav-cta" href="#contact">Contact</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <p class="eyebrow">{profile.name}</p>
      <h1>Platform, Cloud &amp; DevOps Engineer</h1>
      <p class="lede">I build and automate the systems that keep software running.</p>
      <p class="differentiator">Platform, Cloud and DevOps engineer with experience in network operations, software QA and AI-assisted development.</p>

      <div class="ctas">
        {demoLink && (
          <a class="cta primary" href={demoLink.href} target="_blank" rel="noopener noreferrer">
            {demoLink.label}
          </a>
        )}
        {/* Secondary, not primary: the row already has one primary, and
            `--action` only means something while it marks a single action.
            The mailto: href is the fallback when the dialog cannot open. */}
        <a class="cta secondary" href={`mailto:${profile.email}`} data-contact-open>Hire me</a>
        <a class="cta secondary" href="#engineering">See the engineering work</a>
        {profile.cv.href && (
          <a class="cta secondary" href={profile.cv.href} download>Download CV (PDF)</a>
        )}
      </div>

      <dl class="facts">
        <div>
          <dt>Focus</dt>
          <dd>Platform · Cloud · DevOps</dd>
        </div>
        <div>
          <dt>Open to</dt>
          <dd>Full-time or contract · Remote preferred</dd>
        </div>
      </dl>
    </section>

    <section id="what-i-do" aria-labelledby="what-i-do-heading">
      <h2 id="what-i-do-heading" class="section-title">What I do</h2>
      <div class="summary-grid">
        {WHAT_I_DO.map((item) => (
          <article class="summary-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="summary-tech">{item.tech}</span>
          </article>
        ))}
      </div>
    </section>

    <section id="background" aria-labelledby="background-heading">
      <h2 id="background-heading" class="section-title">Why my background is different</h2>
      <p class="section-intro">I started by keeping networks running, moved into software QA, and now build the platform between software and production.</p>
      <div class="summary-grid background-grid">
        <article class="summary-card"><h3>Network operations</h3><p>5 years keeping enterprise systems available, handling incidents, escalations and failover.</p></article>
        <article class="summary-card"><h3>Software QA</h3><p>I learned to test software from the other side of the system — finding problems before they reach users.</p></article>
        <article class="summary-card"><h3>Platform &amp; DevOps</h3><p>I now bring those two perspectives together when designing infrastructure, deployment and engineering workflows.</p></article>
      </div>
    </section>

    <section id="featured-project" aria-labelledby="featured-project-heading">
      <h2 id="featured-project-heading" class="section-title">Featured project</h2>
      <h3 class="featured-title">Top or Drop</h3>
      <p class="section-intro">A real-time multiplayer game I built to demonstrate the complete platform behind a live application.</p>
      <div class="summary-grid">
        <article class="summary-card"><h3>Infrastructure</h3><p>Cloud resources are defined as code so the environment can be rebuilt instead of configured by hand.</p></article>
        <article class="summary-card"><h3>Delivery</h3><p>One pipeline tests and deploys the game to its different environments, with checks before production releases.</p></article>
        <article class="summary-card"><h3>Backend</h3><p>The server controls the game state so players cannot simply tell the client what happened.</p></article>
        <article class="summary-card"><h3>Verification</h3><p>Automated and manual tests check each change before I consider it finished.</p></article>
      </div>
      {featuredRenderedGame && (
        <div class="featured-game" data-accordion="true">
          <GameCard {...featuredRenderedGame.entry.data} slug={featuredRenderedGame.entry.slug} hasBody={featuredRenderedGame.entry.body.trim().length > 0} open={true}>
            <Fragment slot="note"><featuredRenderedGame.Content /></Fragment>
          </GameCard>
        </div>
      )}
    </section>

    {/* The skill cards sit here at the top level and must not be nested back
        inside a game card — site/docs/design.md. */}
    <section id="engineering" aria-labelledby="engineering-heading">
      <h2 id="engineering-heading" class="section-title">
        <span class="section-index">01</span> How I built it
      </h2>
      <p class="section-intro">
        The game is only one part of the system. I built the infrastructure, delivery pipeline and verification process around it.
      </p>
      <EngineeringWorkflowDiagram />

      <BuildingTheGame
        roles={roles}
        total={cardEntries.length}
        intro="Open a card for the diagram and implementation evidence."
      >
        {renderedCards.map(({ entry: card, Content: CardBody }) => {
          const Diagram = diagrams[card.data.role];
          return (
            <Card
              role={card.data.role}
              headline={card.data.headline}
              plain={card.data.plain}
              tools={card.data.tools}
              details={card.data.details}
              video={card.data.video}
              videos={card.data.videos}
              hasBody={card.body.trim().length > 0}
              links={card.data.links}
              wip={card.data.wip}
            >
              {Diagram && <Diagram slot="diagram" />}
              <CardBody />
            </Card>
          );
        })}
      </BuildingTheGame>

    </section>

    <section id="technologies" aria-labelledby="technologies-heading">
      <h2 id="technologies-heading" class="section-title">
        <span class="section-index">02</span> Technologies
      </h2>
      <div class="skills-index" id="skills">
        <div>
          {SKILL_GROUPS.map((group) => (
            <details class="skill-group">
              <summary><span class="skill-group-label">{group.label}</span><span>Show technologies</span></summary>
              <div class="skill-group-items">{group.items.map((item) => <span class="skill">{item}</span>)}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="section-title">
        <span class="section-index">03</span> Projects
      </h2>
      <p class="section-intro">
        Projects where I built, shipped or operated the systems behind the software.
      </p>

      {/* The id is load-bearing: existing #playables links point at it. */}
      <div id="playables" class="playables-strip">
        <Playables
          games={gameEntries.filter((entry) => entry.data.title !== "Top or Drop").map((entry) => ({
            title: entry.data.title,
            status: entry.data.status,
            links: entry.data.links,
          }))}
        />
      </div>

      <div class="vignettes">
        {featuredRenderedGame && (
          <article class="project-feature-link">
            <h3>Top or Drop</h3>
            <p>Real-time multiplayer · platform engineering project</p>
            <a href="#featured-project">View featured project ↑</a>
          </article>
        )}
        <Vignette
          id="in-production"
          label="In production"
          count={inProduction.length}
          countNoun={inProduction.length === 1 ? "title" : "titles"}
          note={inProduction.length === 0
            ? "Nothing shipped under this name yet. The first release lands here."
            : undefined}
        >
          <div class="game-list" data-accordion="true">
            {inProduction.map(({ entry, Content }) => (
              <GameCard
                slug={entry.slug}
                title={entry.data.title}
                status={entry.data.status}
                tagline={entry.data.tagline}
                blurb={entry.data.blurb}
                links={entry.data.links}
                repo={entry.data.repo}
                video={entry.data.video}
                videos={entry.data.videos}
                hasBody={entry.body.trim().length > 0}
              >
                <Fragment slot="note"><Content /></Fragment>
              </GameCard>
            ))}
          </div>
        </Vignette>

        <Vignette
          id="in-development"
          label="In development"
          count={inDevelopment.length}
          countNoun={inDevelopment.length === 1 ? "title" : "titles"}
          open={true}
        >
          <div class="game-list" data-accordion="true">
            {/* Only the first: `toggle` never fires for a tile already open in
                the HTML, so two default-open tiles both stay expanded. */}
            {inDevelopment.filter(({ entry }) => entry.data.title !== "Top or Drop").map(({ entry, Content }, index) => (
              <GameCard
                slug={entry.slug}
                title={entry.data.title}
                status={entry.data.status}
                tagline={entry.data.tagline}
                blurb={entry.data.blurb}
                links={entry.data.links}
                repo={entry.data.repo}
                video={entry.data.video}
                videos={entry.data.videos}
                hasBody={entry.body.trim().length > 0}
                open={index === 0}
              >
                <Fragment slot="note"><Content /></Fragment>
              </GameCard>
            ))}
          </div>
        </Vignette>
      </div>
    </section>

    <section id="cv" aria-labelledby="cv-heading">
      <h2 id="cv-heading" class="section-title">
        <span class="section-index">04</span> CV
      </h2>
      <p class="section-intro">
        My career started in enterprise network operations, moved through software QA, and now focuses on platform and DevOps engineering.
      </p>

      {/* `href: null` hides this. */}
      {profile.cv.href && (
        <p class="cv-download">
          <a class="cta secondary" href={profile.cv.href} download>
            {profile.cv.label}
          </a>
          <span class="cv-download-meta">Updated {profile.cv.updated}</span>
        </p>
      )}

      <div class="vignettes">
        <Vignette
          id="work-history"
          label="Professional work history"
          count={renderedCv.length}
          countNoun={renderedCv.length === 1 ? "role" : "roles"}
          open={true}
          note={renderedCv.length === 0 ? "Roles are being added." : undefined}
        >
          <div class="job-list" data-accordion="true">
            {renderedCv.map(({ entry, Content }) => (
              <CvCard
                slug={entry.slug}
                role={entry.data.role}
                company={entry.data.company}
                location={entry.data.location}
                start={entry.data.start}
                end={entry.data.end}
                summary={entry.data.summary}
                highlights={entry.data.highlights}
                hasBody={entry.body.trim().length > 0}
              >
                <Content />
              </CvCard>
            ))}
          </div>
        </Vignette>

        <Vignette
          id="credentials"
          label="Education & certifications"
          count={CREDENTIALS.length}
          countNoun={CREDENTIALS.length === 1 ? "entry" : "entries"}
        >
          <ul class="credential-list">
            {CREDENTIALS.map((credential) => (
              <li class="credential">
                <h4 class="credential-title">
                  {credential.title}
                  <span class="credential-kind">{credential.kind}</span>
                  <span class="credential-dates">{credential.dates}</span>
                </h4>
                <span class="credential-issuer">{credential.issuer}</span>
                {credential.note && <span class="credential-note">{credential.note}</span>}
              </li>
            ))}
          </ul>
        </Vignette>
      </div>
    </section>

    <section id="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="section-title">
        <span class="section-index">05</span> Let's talk
      </h2>
      <p class="eyebrow">Platform &amp; DevOps Engineer</p>
      <p class="availability">Open to Platform, Cloud and DevOps roles, full-time or contract. Remote preferred; hybrid possible in the Philippines.</p>
      {/* Labelled "Email …": a bare address in a button scans as a heading. */}
      <div class="contact-links">
        <a class="cta primary" href={`mailto:${profile.email}`} data-contact-open>Hire me</a>
        <a class="cta secondary" href={`mailto:${profile.email}`}>Email {profile.email}</a>
        {contactLinks.map((link) => (
          <a class="cta secondary" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
        {profile.cv.href && <a class="cta secondary" href={profile.cv.href} download>CV</a>}
      </div>
    </section>
  </main>

  <ContactDialog />

  <footer>
    <div class="footer-top">
      <p class="footer-id">
        <strong>{profile.name}</strong>
        <span>{profile.title}{profile.location && ` · ${profile.location}`}</span>
      </p>
      <nav class="footer-nav" aria-label="Footer">
        <a href="#engineering">Engineering</a>
        <a href="#projects">Projects</a>
        <a href="#skills">Skills</a>
        <a href="#cv">CV</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
    <p class="footer-meta">
      © {year} {profile.name}
      {/* Discoverable Ctrl+P. Both routes go through the same print hook. */}
      <button class="print-cta" type="button" data-print>Print / Save as PDF</button>
    </p>
  </footer>
</BaseLayout>

<script>
  // Accordion, deep links and print. All document-wide, so no component has to
  // know how deeply it is nested. Behaviour and reasoning: site/docs/design.md.
  const motionOk = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Suspends the accordion while print expands every disclosure — otherwise it
  // closes each card as the next opens and one card reaches paper.
  let printing = false;

  // 1. One open at a time, per group. Not applied to vignettes.
  for (const group of document.querySelectorAll<HTMLElement>("[data-accordion]")) {
    const items = Array.from(group.children).filter(
      (child): child is HTMLDetailsElement => child instanceof HTMLDetailsElement
    );

    // Siblings are removed while one is open, not merely collapsed.
    // `.is-peer-hidden` stays a separate channel from the `hidden` attribute the
    // role filter drives, or closing a card resurrects filtered-out cards.
    const sync = () => {
      const open = items.find((item) => item.open);
      for (const item of items) {
        item.classList.toggle("is-peer-hidden", open !== undefined && item !== open);
      }
    };

    // A `toggle` does not mean the reader did anything — parse and deep links
    // fire it too, and scrolling on either is wrong. The scroll is owed only to
    // a summary the reader activated; keyboard activation dispatches a click.
    let activated: HTMLDetailsElement | null = null;
    group.addEventListener("click", (event) => {
      const parent = (event.target as HTMLElement).closest("summary")?.parentElement;
      activated =
        parent instanceof HTMLDetailsElement && items.includes(parent) ? parent : null;
    });

    for (const item of items) {
      item.addEventListener("toggle", () => {
        if (printing) return;

        if (item.open) {
          for (const sibling of items) {
            if (sibling !== item) sibling.open = false;
          }

          sync();

          // Everything above the open tile just disappeared. Put it back where
          // the reader is looking.
          if (activated === item) {
            activated = null;
            item.scrollIntoView({ block: "start", behavior: motionOk ? "smooth" : "auto" });
          }
          return;
        }

        // A close fired while another tile is open is a side effect of that
        // tile opening. Its box is already zero, so the correction is nonsense.
        if (items.some((other) => other.open)) {
          sync();
          return;
        }

        // Nothing to keep in view if the tile is off the page — a filter change
        // closes and hides in the same beat, and a zero box jumps wildly.
        const box = item.getBoundingClientRect();
        if (item.hidden || box.height === 0) {
          sync();
          return;
        }

        // Restoring the siblings pushes this tile down by their combined
        // height. Measure either side of the change and cancel the difference.
        const before = box.top;
        sync();
        const shift = item.getBoundingClientRect().top - before;
        if (shift !== 0) window.scrollBy({ top: shift, behavior: "auto" });
      });
    }

    // Applied directly: whether a tile open in the HTML fires `toggle` during
    // parse is not consistent across engines.
    sync();
  }

  // 2. A link into something nested opens everything above it, or it scrolls to
  //    a collapsed tile and appears broken.
  const openAncestors = (target: Element) => {
    let node: Element | null = target;
    while (node) {
      // Annotated because `node` is reassigned from this value — without it
      // TypeScript sees the pair as circular and infers `any`.
      const wrapper: HTMLDetailsElement | null = node.closest("details");
      if (!wrapper) break;
      wrapper.open = true;
      node = wrapper.parentElement;
    }
  };

  // A hash can be anything a card author typed, and an id that is not a valid
  // selector throws rather than returning null.
  const find = (hash: string): HTMLElement | null => {
    if (!hash || hash === "#") return null;
    try {
      return document.querySelector<HTMLElement>(hash);
    } catch {
      return null;
    }
  };

  const revealHash = (hash: string, smooth: boolean) => {
    const target = find(hash);
    if (!target) return false;

    if (target instanceof HTMLDetailsElement) target.open = true;
    openAncestors(target);
    target.scrollIntoView({ block: "start", behavior: smooth && motionOk ? "smooth" : "auto" });
    return true;
  };

  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]')) {
    link.addEventListener("click", (event) => {
      const href = link.getAttribute("href");
      if (!href) return;

      const url = new URL(href, document.baseURI);
      const samePage =
        url.origin === window.location.origin && url.pathname === window.location.pathname;
      if (!samePage || !url.hash) return;

      // A card filtered out of view has to come back before it can be opened.
      const targetCard = find(url.hash);
      if (targetCard?.dataset.role) {
        document
          .querySelector<HTMLButtonElement>(`.filter button[data-filter="${targetCard.dataset.role}"]`)
          ?.click();
      }

      if (revealHash(url.hash, true)) event.preventDefault();
    });
  }

  if (window.location.hash) revealHash(window.location.hash, false);

  // 3. Print. A closed `<details>` hides its children through a slot it never
  //    renders into, so no stylesheet can open one — it has to be done to the
  //    DOM. Only what *was* closed is put back, so the reader's own open tiles
  //    survive. What reaches paper is trimmed in the `@media print` block.
  let reclose: HTMLDetailsElement[] = [];

  const expandForPrint = () => {
    printing = true;
    reclose = Array.from(document.querySelectorAll<HTMLDetailsElement>("details")).filter(
      (item) => !item.open
    );
    for (const item of reclose) item.open = true;
  };

  const restoreAfterPrint = () => {
    // Reversed, so a nested disclosure closes before the one containing it and
    // no handler fires against a box that has already collapsed.
    for (const item of reclose.reverse()) item.open = false;
    reclose = [];
    printing = false;
  };

  window.addEventListener("beforeprint", expandForPrint);
  window.addEventListener("afterprint", restoreAfterPrint);

  // Safari fires neither event; it drives print off the media query instead.
  const printQuery = window.matchMedia("print");
  printQuery.addEventListener("change", (event) => {
    if (event.matches) expandForPrint();
    else restoreAfterPrint();
  });

  document.querySelector<HTMLButtonElement>("[data-print]")?.addEventListener("click", () => {
    window.print();
  });
</script>

