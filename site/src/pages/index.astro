---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Playables from "../components/Playables.astro";
import Vignette from "../components/Vignette.astro";
import GameCard from "../components/GameCard.astro";
import CvCard from "../components/CvCard.astro";
import BuildingTheGame from "../components/BuildingTheGame.astro";
import Card from "../components/Card.astro";
import CloudTargetsDiagram from "../components/diagrams/CloudTargetsDiagram.astro";
import QaLoopDiagram from "../components/diagrams/QaLoopDiagram.astro";
import AiWorkflowDiagram from "../components/diagrams/AiWorkflowDiagram.astro";
import DevOpsPipelineDiagram from "../components/diagrams/DevOpsPipelineDiagram.astro";
import BackendEngineeringDiagram from "../components/diagrams/BackendEngineeringDiagram.astro";
import FrontendEngineeringDiagram from "../components/diagrams/FrontendEngineeringDiagram.astro";
import { profile } from "../data/profile";

// One showcase diagram per skill, keyed by the card's `role`. A role with no
// entry here simply renders without one, so adding the remaining diagrams is a
// one-line change per skill.
const diagrams: Record<string, typeof QaLoopDiagram | undefined> = {
  Cloud: CloudTargetsDiagram,
  QA: QaLoopDiagram,
  AI: AiWorkflowDiagram,
  DevOps: DevOpsPipelineDiagram,
  Backend: BackendEngineeringDiagram,
  Frontend: FrontendEngineeringDiagram,
};

// Filter buttons follow this order, not the cards' display order. A role present
// in the cards but missing here is appended rather than dropped.
//
// Cloud and DevOps lead because they are what the target roles are actually
// hiring for. QA and AI describe how the work gets done, which is a second
// question — putting them first, as this list used to, made two process cards
// the first thing a platform reader saw.
const ROLE_ORDER = ["Cloud", "DevOps", "Backend", "Frontend", "QA", "AI"];

// Plain-English capability lines for the recruiter layer, each with the
// implementation named after it. Deliberately in this order and deliberately
// not a content collection: four lines that change when the stack does, not
// four files with a schema. The pattern is the point — someone who does not
// know what EKS is still learns what was built, and someone who does gets the
// receipt in the same row.
const CAPABILITIES = [
  {
    plain:
      "Build cloud infrastructure that runs and scales containerised applications, defined entirely as code so it can be destroyed and rebuilt from one source",
    tech: "AWS · EKS · Terraform · Docker",
  },
  {
    plain:
      "Automate the delivery pipeline that tests, signs and deploys every release, with gates so nothing reaches production unproven",
    tech: "GitHub Actions · OIDC · Cloudflare",
  },
  {
    plain:
      "Design the backend behind real-time multiplayer, where the server holds the truth and the client only draws it",
    tech: "Node.js · Redis · WebSocket",
  },
  {
    plain:
      "Verify it — five years of enterprise network operations and a current software QA role, applied to my own work",
    tech: "Jenkins · GUT · Node test runner",
  },
];

// Section 00's closing block. The cards above prove these in context; this is
// the flat enumeration a reader scanning for one word needs, and the surface an
// applicant tracking system reads. Networking and QA tooling are here because
// five years of the CV uses them and nothing else on the page names them.
//
// Every entry is something actually used. Nothing aspirational goes in this
// list — it is the one block on the page with no surrounding prose to qualify
// it, so an unearned entry here reads as a straight claim.
const SKILL_GROUPS: { label: string; items: string[] }[] = [
  {
    label: "Cloud & infrastructure",
    items: [
      "AWS (EKS, EC2, ElastiCache, S3, IAM)",
      "Terraform",
      "Kubernetes",
      "Docker",
      "Cloudflare (Tunnel, R2, Workers)",
      "Linux",
    ],
  },
  {
    label: "CI/CD & automation",
    items: [
      "GitHub Actions",
      "Composite actions",
      "Jenkins",
      "OIDC federated identity",
      "Google Play Publisher API",
      "Git / GitHub",
    ],
  },
  {
    label: "Backend & data",
    items: ["Node.js", "Redis", "WebSocket (ws)", "REST", "Java / Kotlin"],
  },
  {
    label: "Client & game",
    items: ["Godot 4", "GDScript", "Android builds"],
  },
  {
    label: "QA & testing",
    items: [
      "Test plan & test case design",
      "Functional & regression testing",
      "Exploratory testing",
      "Defect tracking",
      "GUT (Godot)",
      "Node.js test runner",
    ],
  },
  {
    label: "Networking & operations",
    items: [
      "VoIP",
      "IPVPN",
      "METRO-E",
      "DIA",
      "WAN / LAN / WLAN",
      "SDH transmission",
      "3G / LTE provisioning",
      "NMS alarm monitoring",
      "Fault isolation & failover",
      "Nokia–Huawei SD-WAN",
      "BERT / OTDR",
      "CLI / SSH",
    ],
  },
  {
    label: "AI-assisted engineering",
    items: [
      "Claude Code",
      "Codex",
      "Cursor",
      "MCP tool servers",
      "Prompt & context engineering",
      "Retrieval-augmented generation",
    ],
  },
];

// Section 02's second vignette. Deliberately not a content collection: three
// static facts that change once a decade do not need one file each and a schema.
// Deliberately not `<details>` tiles either — a credential has nothing to hide,
// so it renders as a flat row. That keeps it visibly a different thing from the
// job tiles directly above it, which is the level-grammar rule doing its job.
// Annotated rather than inferred: only one entry carries a `note`, and without
// this TypeScript infers a union the optional field is missing from.
const CREDENTIALS: {
  kind: string;
  title: string;
  issuer: string;
  dates: string;
  note?: string;
}[] = [
  {
    kind: "Degree",
    title: "BS Electronics and Communications Engineering",
    issuer: "University of the East",
    dates: "2008 — 2014",
  },
  {
    kind: "Licence",
    title: "Licensed Electronics Engineer",
    issuer: "Professional Regulation Commission (PRC), Philippines",
    dates: "Oct 2014",
  },
  {
    kind: "Training",
    title: "Nokia-Huawei SD-WAN",
    issuer: "Globe Telecom",
    dates: "Apr 2018",
    note: "32 hours, covering virtual WAN operations.",
  },
];

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

// `hidden: true` entries stay in their collection and stay validated — they are
// just not published. Every count, filter and grid on the page derives from
// these three lists, so nothing else has to know they exist.
const cardEntries = (await getCollection("cards", ({ data }) => !data.hidden)).sort(byOrder);
const gameEntries = (await getCollection("games", ({ data }) => !data.hidden)).sort(byOrder);
const cvEntries = (await getCollection("cv", ({ data }) => !data.hidden)).sort(byOrder);

const presentRoles = [...new Set(cardEntries.map((entry) => entry.data.role))];
const roles = [
  ...ROLE_ORDER.filter((role) => presentRoles.includes(role)),
  ...presentRoles.filter((role) => !ROLE_ORDER.includes(role)),
];

const renderedCards = await Promise.all(
  cardEntries.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);
const renderedGames = await Promise.all(
  gameEntries.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);
const renderedCv = await Promise.all(
  cvEntries.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);

const inProduction = renderedGames.filter((game) => game.entry.data.status === "production");
const inDevelopment = renderedGames.filter((game) => game.entry.data.status === "development");

// The hero's play button. Derived, not hardcoded: play destinations belong to
// the game file, and the one game carrying the skill cards is the one the hero
// is talking about. No game with links, no button.
const featuredGame =
  gameEntries.find((entry) => entry.data.buildingTheGame) ??
  inDevelopment[0]?.entry ??
  gameEntries[0];
const demoLink = featuredGame?.data.links[0];

// A profile link with no URL yet is a placeholder waiting for one, not a button.
const contactLinks = profile.links.filter(
  (link): link is { label: string; href: string } => Boolean(link.href)
);

const year = new Date().getFullYear();
---

<BaseLayout
  title={`${profile.name} — ${profile.jobTitle}`}
  description={`${profile.jobTitle} in ${profile.location}. Five years of enterprise network operations, then software QA, now platform and DevOps. A deploy-on-demand AWS environment, a gated CI/CD pipeline to five destinations, and ${profile.project} — a real-time multiplayer game you can play, with the source behind it.`}
>
  <header class="site-header">
    <a class="wordmark" href="/">
      <span class="wordmark-mark" aria-hidden="true"></span>
      {profile.name}
    </a>
    <nav aria-label="Primary">
      <a href="#engineering">Engineering</a>
      <a href="#projects">Projects</a>
      <a href="#cv">CV</a>
      <a class="nav-cta" href="#contact">Contact</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      {/* The h1 says what the job title is, in words someone who does not know
          what EKS stands for can still act on. It used to be a slogan about
          agents, which is a true and distinctive thing to say and the wrong
          thing to say first: it framed the reader's first impression around the
          tooling rather than the engineering, and a screener filtering for a
          platform role found no role in the strongest tag on the page. The
          orchestrator claim is not gone — it moved to `.method` below, where it
          gets the room to say what it actually means. */}
      <p class="eyebrow">{profile.name}</p>
      <h1>I build the cloud infrastructure and delivery pipelines software runs on.</h1>
      <p class="lede">
        Five years running enterprise network operations, then software QA, now platform
        and DevOps. <strong>{profile.project}</strong> is where I prove it — a real-time
        multiplayer game with the whole platform underneath it, built against a fixed
        monthly ceiling and torn back down to zero when nobody is playing.
      </p>
      {/* The differentiator, and the reason the CV reads as a route rather than
          a wander. One sentence, because it only works if it is quotable. */}
      <p class="differentiator">
        Most engineers own one layer. I have run the network under the application,
        tested the application, and built the platform in between.
      </p>

      <div class="ctas">
        {demoLink && (
          <a class="cta primary" href={demoLink.href} target="_blank" rel="noopener noreferrer">
            {demoLink.label}
          </a>
        )}
        <a class="cta secondary" href="#card-cloud">See the infrastructure work</a>
        {profile.cv.href && (
          <a class="cta secondary" href={profile.cv.href} download>Download CV (PDF)</a>
        )}
      </div>

      {/* Four facts, in the order someone screening actually asks them. */}
      <dl class="facts">
        <div>
          <dt>Based</dt>
          <dd>{profile.locationFull} · {profile.timezone}</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Platform · Cloud · DevOps, with QA and AI orchestration behind it</dd>
        </div>
        <div>
          <dt>Open to</dt>
          <dd>Full-time or contract · remote preferred, hybrid in the Philippines</dd>
        </div>
        <div>
          {/* Platform work first, day job second. Both are true and both stay;
              the order is the whole edit. */}
          <dt>Now</dt>
          <dd>Building {profile.project} end to end · QA Tester at Amber</dd>
        </div>
      </dl>

      {/* Plain English first, implementation second, on the same row. The
          technical terms are not hidden — they are just not the thing a reader
          has to decode before they learn what was built. */}
      <div class="capabilities">
        <p class="block-label">What I actually do</p>
        <ul>
          {CAPABILITIES.map((capability) => (
            <li>
              <span class="capability-plain">{capability.plain}</span>
              <span class="capability-tech">{capability.tech}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* The orchestrator claim, given the room to mean what it means. The old
          hero line — "agents do the implementing, the sign-off is mine" — was
          true but described a reviewer. The load-bearing half was missing: the
          delegation is bounded by what can be read back. Choosing Godot because
          the GDScript is legible to me, Node because I already know it, is the
          reason the review is worth anything. */}
      <div class="method">
        <p class="block-label">How I work</p>
        <p>
          I decide the architecture, the environments and what they are allowed to cost —
          and I pick tools I can read and verify myself: Godot because I write GDScript,
          Node.js because I already know it. Agents accelerate the implementation I would
          otherwise type by hand. <strong>The design decisions, the review and the
          sign-off are mine</strong>, which is only worth saying because the stack was
          chosen so that I can actually make them.
          <a class="method-link" href="#card-ai">How that works, step by step →</a>
        </p>
      </div>
    </section>

    {/* Section 00, and it used to be section 01's fourth level. The six cards
        below were mounted inside the Top or Drop game card, which put the
        Terraform and CI/CD work five clicks from the hero behind a heading that
        said "Games". The nesting was good information architecture answering
        the wrong question: it optimised for a reader already convinced, and the
        reader who has to be convinced never got there. */}
    <section id="engineering" aria-labelledby="engineering-heading">
      <h2 id="engineering-heading" class="section-title">
        <span class="section-index">00</span> Engineering
      </h2>
      <p class="section-intro">
        Six disciplines, each one a working part of {profile.project} — the real-time
        multiplayer game in section 01, which is the laboratory rather than the point.
        Cloud and DevOps carry the platform argument; Backend and Frontend are the
        application on top of it; QA and AI are how any of it gets checked before it
        counts as done.
      </p>

      <BuildingTheGame
        roles={roles}
        total={cardEntries.length}
        intro="Each card opens to the diagram of how that part actually works, the recording of it running, then the steps behind it — click any step in a diagram to jump to its explanation."
      >
        {renderedCards.map(({ entry: card, Content: CardBody }) => {
          const Diagram = diagrams[card.data.role];
          return (
            <Card
              role={card.data.role}
              headline={card.data.headline}
              plain={card.data.plain}
              tools={card.data.tools}
              details={card.data.details}
              video={card.data.video}
              videos={card.data.videos}
              hasBody={card.body.trim().length > 0}
              links={card.data.links}
            >
              {Diagram && <Diagram slot="diagram" />}
              <CardBody />
            </Card>
          );
        })}
      </BuildingTheGame>

      {/* Flat, always visible, and not behind a disclosure on purpose. The cards
          above prove these in context; this is for the reader deciding in four
          seconds whether Kubernetes appears anywhere, and for the tracking
          system that reads the markup rather than the page. */}
      <div class="skills-index" id="skills">
        <p class="block-label">Tools &amp; technologies</p>
        <dl>
          {SKILL_GROUPS.map((group) => (
            <div class="skill-group">
              <dt>{group.label}</dt>
              <dd>
                {group.items.map((item) => <span class="skill">{item}</span>)}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="section-title">
        <span class="section-index">01</span> Projects
      </h2>
      <p class="section-intro">
        The things section 00 was built for. Every link in the first row leaves the site
        and starts something you can play; open a tile for what it is and where else it
        runs.
      </p>

      {/* Was its own section 00. Folded in here rather than dropped: a direct
          route out to a running build is worth keeping, but it is not what a
          platform reader is here for, and it should not be the first thing
          under the hero. The id survives so existing #playables links resolve. */}
      <div id="playables" class="playables-strip">
        <Playables
          games={gameEntries.map((entry) => ({
            title: entry.data.title,
            status: entry.data.status,
            links: entry.data.links,
          }))}
        />
      </div>

      <div class="vignettes">
        <Vignette
          id="in-production"
          label="In production"
          count={inProduction.length}
          countNoun={inProduction.length === 1 ? "title" : "titles"}
          note={inProduction.length === 0
            ? "Nothing shipped under this name yet. The first release lands here."
            : undefined}
        >
          <div class="game-list" data-accordion="true">
            {inProduction.map(({ entry, Content }) => (
              <GameCard
                slug={entry.slug}
                title={entry.data.title}
                status={entry.data.status}
                tagline={entry.data.tagline}
                blurb={entry.data.blurb}
                links={entry.data.links}
                repo={entry.data.repo}
                video={entry.data.video}
                videos={entry.data.videos}
                hasBody={entry.body.trim().length > 0}
              >
                <Fragment slot="note"><Content /></Fragment>
              </GameCard>
            ))}
          </div>
        </Vignette>

        <Vignette
          id="in-development"
          label="In development"
          count={inDevelopment.length}
          countNoun={inDevelopment.length === 1 ? "title" : "titles"}
          open={true}
        >
          <div class="game-list" data-accordion="true">
            {/* Only the first one. The accordion script enforces one-open-at-a-time
                from the `toggle` event, which never fires for a tile that was
                already open in the HTML — so opening every in-development game
                here would render two expanded at once until something was
                clicked. */}
            {inDevelopment.map(({ entry, Content }, index) => (
              <GameCard
                slug={entry.slug}
                title={entry.data.title}
                status={entry.data.status}
                tagline={entry.data.tagline}
                blurb={entry.data.blurb}
                links={entry.data.links}
                repo={entry.data.repo}
                video={entry.data.video}
                videos={entry.data.videos}
                hasBody={entry.body.trim().length > 0}
                open={index === 0}
              >
                <Fragment slot="note"><Content /></Fragment>
                {entry.data.buildingTheGame && (
                  <p class="game-crosslink">
                    <a href="#engineering">How this one was built — six disciplines in section 00 →</a>
                  </p>
                )}
              </GameCard>
            ))}
          </div>
        </Vignette>
      </div>
    </section>

    <section id="cv" aria-labelledby="cv-heading">
      <h2 id="cv-heading" class="section-title">
        <span class="section-index">02</span> CV
      </h2>
      <p class="section-intro">
        Five years running enterprise network operations, then a deliberate return through
        software QA to see how the applications on top of that infrastructure actually
        behave. Both halves point the same way. Open a role for what it involved.
      </p>

      {/* Recruiters need a file for their tracking system, and asking them to
          transcribe a web page loses candidates. `href: null` hides this. */}
      {profile.cv.href && (
        <p class="cv-download">
          <a class="cta secondary" href={profile.cv.href} download>
            {profile.cv.label}
          </a>
          <span class="cv-download-meta">Updated {profile.cv.updated}</span>
        </p>
      )}

      <div class="vignettes">
        <Vignette
          id="work-history"
          label="Professional work history"
          count={renderedCv.length}
          countNoun={renderedCv.length === 1 ? "role" : "roles"}
          open={true}
          note={renderedCv.length === 0 ? "Roles are being added." : undefined}
        >
          <div class="job-list" data-accordion="true">
            {renderedCv.map(({ entry, Content }) => (
              <CvCard
                slug={entry.slug}
                role={entry.data.role}
                company={entry.data.company}
                location={entry.data.location}
                start={entry.data.start}
                end={entry.data.end}
                summary={entry.data.summary}
                highlights={entry.data.highlights}
                hasBody={entry.body.trim().length > 0}
              >
                <Content />
              </CvCard>
            ))}
          </div>
        </Vignette>

        <Vignette
          id="credentials"
          label="Education & certifications"
          count={CREDENTIALS.length}
          countNoun={CREDENTIALS.length === 1 ? "entry" : "entries"}
        >
          <ul class="credential-list">
            {CREDENTIALS.map((credential) => (
              <li class="credential">
                <h4 class="credential-title">
                  {credential.title}
                  <span class="credential-kind">{credential.kind}</span>
                  <span class="credential-dates">{credential.dates}</span>
                </h4>
                <span class="credential-issuer">{credential.issuer}</span>
                {credential.note && <span class="credential-note">{credential.note}</span>}
              </li>
            ))}
          </ul>
        </Vignette>
      </div>
    </section>

    <section id="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="section-title">
        <span class="section-index">03</span> Get in touch
      </h2>
      <p class="eyebrow">{profile.title}</p>
      {profile.availability && <p class="availability">{profile.availability}</p>}
      {/* Labelled "Email …" rather than showing the bare address. A raw string
          sitting in a button reads as a heading to anyone scanning, and the one
          thing this section has to be unambiguous about is that this is where
          you write to. */}
      <div class="contact-links">
        <a class="cta primary" href={`mailto:${profile.email}`}>Email {profile.email}</a>
        {contactLinks.map((link) => (
          <a class="cta secondary" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-top">
      <p class="footer-id">
        <strong>{profile.name}</strong>
        <span>{profile.title}{profile.location && ` · ${profile.location}`}</span>
      </p>
      <nav class="footer-nav" aria-label="Footer">
        <a href="#engineering">Engineering</a>
        <a href="#projects">Projects</a>
        <a href="#skills">Skills</a>
        <a href="#cv">CV</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
    <p class="footer-meta">© {year} {profile.name}</p>
  </footer>
</BaseLayout>

<script>
  // Two behaviours the four-level structure needs, both document-wide so no
  // component has to know how deeply it happens to be nested.
  const motionOk = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // 1. One open at a time, per group — and while one is open the rest are taken
  //    off the page rather than left as a stack of closed titles above and
  //    below it. Applied to the card lists (games, jobs, skills) but
  //    deliberately not to the vignettes: the cards are the bulky things, and a
  //    reader may legitimately want two vignettes open at once.
  for (const group of document.querySelectorAll<HTMLElement>("[data-accordion]")) {
    const items = Array.from(group.children).filter(
      (child): child is HTMLDetailsElement => child instanceof HTMLDetailsElement
    );

    // Siblings are removed while one is open, not merely collapsed. Closing it
    // brings them back. `.is-peer-hidden` is deliberately a separate channel
    // from the `hidden` attribute the role filter drives — sharing one would
    // let closing a card resurrect cards the filter had taken away.
    const sync = () => {
      const open = items.find((item) => item.open);
      for (const item of items) {
        item.classList.toggle("is-peer-hidden", open !== undefined && item !== open);
      }
    };

    // A `toggle` does not mean the reader did anything. A tile marked open in
    // the HTML fires one as the page is parsed, and a deep link opens tiles
    // programmatically — scrolling on either is wrong. The first drags a fresh
    // visitor past the hero into whichever tile happens to be open by default;
    // the second fights revealHash's own scroll. So the scroll is owed only to
    // a summary the reader actually activated. Keyboard activation of a
    // <summary> dispatches a click too, so this covers both.
    let activated: HTMLDetailsElement | null = null;
    group.addEventListener("click", (event) => {
      const parent = (event.target as HTMLElement).closest("summary")?.parentElement;
      activated =
        parent instanceof HTMLDetailsElement && items.includes(parent) ? parent : null;
    });

    for (const item of items) {
      item.addEventListener("toggle", () => {
        if (item.open) {
          for (const sibling of items) {
            if (sibling !== item) sibling.open = false;
          }

          sync();

          // Everything above the open tile just disappeared, which drags it up
          // under the reader's cursor. Put it back where they are looking.
          if (activated === item) {
            activated = null;
            item.scrollIntoView({ block: "start", behavior: motionOk ? "smooth" : "auto" });
          }
          return;
        }

        // A close fired while another tile is open is a side effect of that
        // tile opening, not the reader closing this one. It is already hidden,
        // so its box is zero and the correction below would be nonsense.
        if (items.some((other) => other.open)) {
          sync();
          return;
        }

        // Nothing to keep in view if the tile is not on the page — a role
        // filter change closes every card and hides most of them in the same
        // beat, and measuring one of those gives a zero box and a wild jump.
        const box = item.getBoundingClientRect();
        if (item.hidden || box.height === 0) {
          sync();
          return;
        }

        // Restoring the siblings puts every tile above this one back on the
        // page, pushing it down by their combined height — from the reader's
        // side the page appears to jump back to the top of the list. Measure
        // the tile either side of the change and cancel the difference out, so
        // the tile they just closed stays under their eye.
        const before = box.top;
        sync();
        const shift = item.getBoundingClientRect().top - before;
        if (shift !== 0) window.scrollBy({ top: shift, behavior: "auto" });
      });
    }

    // Applied directly rather than left to the toggle handler: whether a tile
    // marked open in the HTML fires `toggle` during parse is not consistent
    // across engines, and the peer state has to be right either way.
    sync();
  }

  // 2. A link into something nested has to open everything above it, or it
  //    scrolls to a collapsed tile and appears broken. Covers the per-step
  //    evidence links that point at another card, the nav, and a hash typed
  //    straight into the address bar.
  const openAncestors = (target: Element) => {
    let node: Element | null = target;
    while (node) {
      // Annotated because `node` is reassigned from this value — without it
      // TypeScript sees the pair as circular and infers `any`.
      const wrapper: HTMLDetailsElement | null = node.closest("details");
      if (!wrapper) break;
      wrapper.open = true;
      node = wrapper.parentElement;
    }
  };

  // A hash can be anything a card author typed, and an id that is not a valid
  // selector throws rather than returning null.
  const find = (hash: string): HTMLElement | null => {
    if (!hash || hash === "#") return null;
    try {
      return document.querySelector<HTMLElement>(hash);
    } catch {
      return null;
    }
  };

  const revealHash = (hash: string, smooth: boolean) => {
    const target = find(hash);
    if (!target) return false;

    if (target instanceof HTMLDetailsElement) target.open = true;
    openAncestors(target);
    target.scrollIntoView({ block: "start", behavior: smooth && motionOk ? "smooth" : "auto" });
    return true;
  };

  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]')) {
    link.addEventListener("click", (event) => {
      const href = link.getAttribute("href");
      if (!href) return;

      const url = new URL(href, document.baseURI);
      const samePage =
        url.origin === window.location.origin && url.pathname === window.location.pathname;
      if (!samePage || !url.hash) return;

      // A card filtered out of view has to come back before it can be opened.
      const targetCard = find(url.hash);
      if (targetCard?.dataset.role) {
        document
          .querySelector<HTMLButtonElement>(`.filter button[data-filter="${targetCard.dataset.role}"]`)
          ?.click();
      }

      if (revealHash(url.hash, true)) event.preventDefault();
    });
  }

  if (window.location.hash) revealHash(window.location.hash, false);
</script>

